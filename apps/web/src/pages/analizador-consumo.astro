---
import Base from "../layouts/Base.astro";
import AyudaHerramienta from "../components/AyudaHerramienta.astro";
import { esquemaFaq } from "../lib/faq";
import SubirFichero from "../components/SubirFichero.astro";
import { festivos } from "../lib/datos";
const preguntasAyuda = [
  { p: "¿De dónde saco el fichero de consumos?", r: "De Datadis o del área de clientes de tu distribuidora (la empresa de los cables de tu zona, no tu compañía de la luz). Es gratis y lo tienes si tienes contador inteligente." },
  { p: "¿Qué es un consumo fantasma normal?", r: "En un piso, entre 50 y 150 W constantes (nevera aparte) es habitual. Por encima de 200 W suele haber aparatos en espera que se pueden apagar con una regleta." },
  { p: "¿Cuánto gasta un hogar medio?", r: "Unos 2.500–3.500 kWh al año, es decir, entre 200 y 300 kWh al mes. Con calefacción eléctrica o coche eléctrico, bastante más." },
  { p: "¿Mis datos se suben a algún sitio?", r: "No. El fichero se lee y se analiza en tu navegador. Solo si lo pides guardamos un resumen en este navegador, y lo puedes borrar cuando quieras." },
];
const faqAnalizador = esquemaFaq(preguntasAyuda);

---

<Base
  schema={faqAnalizador}
  migas={[["Herramientas", "/herramientas/"], ["Analizador de consumo"]]}
  titulo="Analizador de consumo de luz gratis: tu fichero en gráficas"
  descripcion="Sube tu fichero de Datadis o de tu distribuidora y mira a qué horas, días y meses gastas más luz, tu consumo fantasma y tus picos. Gratis y sin registro."
>
  <section class="hero hero--compacto">
    <div class="wrap">
      <span class="eyebrow">Analizador de consumo</span>
      <h1>¿Cuándo gastas la luz? Tu consumo, hora a hora</h1>
      <p class="lead">Gráficas de tu consumo por horas, días y meses, tu consumo fantasma, tus picos y consejos concretos para tu caso. Todo se calcula en tu navegador.</p>
    </div>
  </section>

  <section class="section section--tight">
    <div class="wrap">
      <div style="max-width:800px">
        <SubirFichero id="an" />
        <div class="field" style="max-width:280px;margin-top:20px">
          <label for="an-pot">Tu potencia contratada (opcional)</label>
          <input id="an-pot" type="number" inputmode="decimal" min="1" max="15" step="0.01" placeholder="Ej.: 4,6" />
          <span class="hint">kW. Para decirte si te sobra.</span>
        </div>
      </div>
      <div id="an-res" class="an-res" hidden tabindex="-1" aria-live="polite"></div>
    </div>
  </section>

  <script type="application/json" id="datos-an" set:html={JSON.stringify({ festivos })} />

  <AyudaHerramienta
    titulo="Qué te dice el analizador"
    preguntas={preguntasAyuda}
    guias={[
      { href: "/guias/descargar-consumo-datadis/", t: "Descargar tu consumo con Datadis" },
      { href: "/guias/consumo-fantasma/", t: "Consumo fantasma: qué es y cómo bajarlo" },
      { href: "/guias/consumo-medio-hogar/", t: "Consumo medio de un hogar en España" },
      { href: "/guias/reducir-consumo/", t: "15 trucos para gastar menos luz" },
    ]}
  >
    <ul>
      <li><strong>Cuándo gastas</strong>: horas, días de la semana y meses, y cuánto cae en punta, llano y valle.</li>
      <li><strong>Consumo fantasma</strong>: lo que gasta tu casa cuando no hay nadie haciendo nada (nevera, routers, aparatos en espera).</li>
      <li><strong>Picos</strong>: las horas de más consumo, para saber si te sobra o te falta potencia.</li>
      <li><strong>Comparación</strong> con un hogar medio, para saber si gastas mucho o poco.</li>
    </ul>
    <p>Todo se calcula en tu navegador. Si quieres, puedes guardar el resumen en este navegador para usarlo en la calculadora solar.</p>
  </AyudaHerramienta>
</Base>

<script>
  import { analizarConsumo, type Lectura } from "@lst/tarifa";
  import { montarSubida } from "../scripts/fichero-ui";
  import { barras, lineas, calor } from "../lib/graficas";
  import { eur, kwh, num, pct, fechaCorta, fechaMedia, nombreMes } from "../lib/formato";

  const festivos = new Set<string>(JSON.parse(document.getElementById("datos-an")!.textContent!).festivos);
  const res = document.getElementById("an-res")!;
  const MESES = ["Ene", "Feb", "Mar", "Abr", "May", "Jun", "Jul", "Ago", "Sep", "Oct", "Nov", "Dic"];
  const SEMANA = ["Lunes", "Martes", "Miércoles", "Jueves", "Viernes", "Sábado", "Domingo"];
  const HORAS = Array.from({ length: 24 }, (_, h) => String(h).padStart(2, "0"));
  // Precio orientativo con impuestos para traducir kWh a euros en los consejos.
  const PRECIO = 0.18;
  let ultimas: Lectura[] | null = null;

  function pintar(lecturas: Lectura[]) {
    ultimas = lecturas;
    const r = analizarConsumo(lecturas, festivos);
    const potencia = parseFloat((document.getElementById("an-pot") as HTMLInputElement).value.replace(",", "."));
    const pctValle = r.porPeriodo[3] / r.kwh;
    const pctPunta = r.porPeriodo[1] / r.kwh;
    const baseW = r.baseKw * 1000;
    const consejos: string[] = [];
    if (baseW > 120) consejos.push(`<strong>Consumo fantasma alto:</strong> de madrugada, con todo apagado, tu casa sigue gastando unos ${num(baseW)} W. Son ${kwh(r.baseAnual)} al año (unos ${eur(r.baseAnual * PRECIO)}). Busca aparatos en espera con un enchufe medidor. <a href="/guias/consumo-fantasma/">Cómo encontrarlos</a>`);
    else consejos.push(`<strong>Consumo de fondo razonable:</strong> unos ${num(baseW)} W de madrugada (nevera, router…).`);
    if (pctValle > 0.45) consejos.push(`<strong>Consumes mucho en valle (${pct(pctValle)}):</strong> una tarifa de tres periodos o indexada te suele favorecer. <a href="/tarifas/">Ver el ranking</a>`);
    else if (pctPunta > 0.35) consejos.push(`<strong>Mucho consumo en punta (${pct(pctPunta)}):</strong> un precio único 24 horas te protege, o mueve la lavadora y el lavavajillas a la noche.`);
    if (potencia > 0) {
      const sugerida = Math.max(2.3, Math.ceil(r.maxHora.kwh * 1.3 * 10) / 10);
      consejos.push(potencia > sugerida + 0.3
        ? `<strong>Te sobra potencia:</strong> tu hora de más consumo fue de ${num(r.maxHora.kwh, 2)} kWh y tienes ${num(potencia, 2)} kW. Podrías probar con unos ${num(sugerida, 1)} kW. <a href="/guias/potencia-contratada/">Cómo bajarla</a>`
        : `<strong>Tu potencia está ajustada</strong> a tu consumo máximo (${num(r.maxHora.kwh, 2)} kWh en una hora).`);
    }
    const mesMax = r.porMes.reduce((a, m) => (m.kwh / m.dias > a.kwh / a.dias ? m : a));
    const diaSemMax = r.porDiaSemana.indexOf(Math.max(...r.porDiaSemana));

    res.hidden = false;
    res.innerHTML = `
      <div class="res-cab card card--roomy">
        <span class="eyebrow">Tu consumo del ${fechaCorta(r.desde)} al ${fechaCorta(r.hasta)}</span>
        <p class="answer">Gastas <strong>${kwh(r.mediaDia)}</strong> al día</p>
        <p class="lead">Unos ${kwh(r.anual)} al año. Tu mes de más consumo fue ${nombreMes(mesMax.mes)} y el día de la semana, el ${SEMANA[diaSemMax].toLowerCase()}.</p>
      </div>
      <div class="grid grid--4 an-stats">
        <div class="stat"><span class="stat__label">Total del fichero</span><span class="stat__value">${num(r.kwh)}<small> kWh</small></span><span class="stat__sub">${r.dias} días</span></div>
        <div class="stat"><span class="stat__label">Consumo de fondo</span><span class="stat__value">${num(baseW)}<small> W</small></span><span class="stat__sub">${kwh(r.baseAnual)} al año</span></div>
        <div class="stat"><span class="stat__label">Hora de más consumo</span><span class="stat__value">${num(r.maxHora.kwh, 2)}<small> kWh</small></span><span class="stat__sub">${fechaCorta(r.maxHora.fecha)} a las ${HORAS[r.maxHora.hora]}:00</span></div>
        <div class="stat"><span class="stat__label">En horas valle</span><span class="stat__value">${pct(pctValle)}</span><span class="stat__sub">punta ${pct(pctPunta)}</span></div>
      </div>
      <div class="card stack an-consejos" style="--stack:10px"><h2 class="an-h">Lo que dice tu consumo</h2><ul>${consejos.map((c) => `<li>${c}</li>`).join("")}</ul></div>
      <div class="grid grid--2">
        ${barras({ titulo: "Consumo medio diario por mes", etiquetas: r.porMes.map((m) => MESES[Number(m.mes.slice(5)) - 1] + " " + m.mes.slice(2, 4)), valores: r.porMes.map((m) => m.kwh / m.dias), unidad: "kWh/día", resaltar: [r.porMes.indexOf(mesMax)] })}
        ${lineas("A qué hora consumes (día medio)", HORAS, [{ nombre: "Laborables", valores: r.perfilLaborable, color: "a" }, { nombre: "Fines de semana y festivos", valores: r.perfilFinde, color: "b" }], "kWh", 2)}
        ${barras({ titulo: "Consumo medio por día de la semana", etiquetas: SEMANA.map((d) => d.slice(0, 3)), valores: r.porDiaSemana, unidad: "kWh/día", resaltar: [diaSemMax] })}
        <div class="card stack" style="--stack:12px">
          <h3 class="an-h">Reparto por periodos</h3>
          <div class="reparto" role="img" aria-label="Punta ${pct(pctPunta)}, llano ${pct(r.porPeriodo[2] / r.kwh)}, valle ${pct(pctValle)}">
            <span class="r-p1" style="width:${pctPunta * 100}%">${pctPunta > 0.12 ? pct(pctPunta) : ""}</span>
            <span class="r-p2" style="width:${(r.porPeriodo[2] / r.kwh) * 100}%">${r.porPeriodo[2] / r.kwh > 0.12 ? pct(r.porPeriodo[2] / r.kwh) : ""}</span>
            <span class="r-p3" style="width:${pctValle * 100}%">${pctValle > 0.12 ? pct(pctValle) : ""}</span>
          </div>
          <ul class="small"><li><strong>Punta</strong> (10–14 h y 18–22 h laborables): ${kwh(r.porPeriodo[1])}</li><li><strong>Llano:</strong> ${kwh(r.porPeriodo[2])}</li><li><strong>Valle</strong> (noches y fines de semana): ${kwh(r.porPeriodo[3])}</li></ul>
          <h3 class="an-h" style="margin-top:16px">Tus 5 días de más consumo</h3>
          <ol class="small">${r.topDias.map((d) => `<li>${fechaMedia(d.fecha)}: <strong>${kwh(d.kwh)}</strong></li>`).join("")}</ol>
        </div>
      </div>
      ${calor("Mapa de calor: hora del día por mes", MESES, HORAS, r.calor, "kWh medios")}
      <div class="card card--roomy an-cta">
        <div><h2 class="an-h">¿Y ahora qué tarifa te conviene?</h2><p class="muted">Con este mismo fichero calculamos cuánto pagarías con cada una de las tarifas del mercado, o tus facturas mes a mes.</p></div>
        <p class="btn-row"><a class="btn btn--mint" href="/comparador/">Comparar tarifas con mi fichero</a><a class="btn btn--ghost" href="/calcular-factura-luz/">Calcular mis facturas</a></p>
      </div>`;
    res.focus({ preventScroll: true });
    res.scrollIntoView({ block: "start" });
  }

  montarSubida("an", (f) => pintar(f.lecturas));
  document.getElementById("an-pot")!.addEventListener("change", () => ultimas && pintar(ultimas));
</script>

<style is:global>
  .an-res {
    display: grid;
    gap: 24px;
    margin-top: 48px;
    scroll-margin-top: 88px;
  }
  .an-res:focus {
    outline: none;
  }
  .an-res .answer {
    margin: 8px 0;
  }
  .an-h {
    font-size: 20px;
    font-weight: 500;
    color: var(--color-bark);
    letter-spacing: 0;
  }
  .an-consejos ul {
    margin: 0;
    padding-left: 1.2em;
    display: grid;
    gap: 8px;
  }
  .an-cta {
    display: flex;
    flex-wrap: wrap;
    gap: 16px 32px;
    align-items: center;
    justify-content: space-between;
  }
  @media (min-width: 720px) and (max-width: 1023px) {
    .an-stats {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
