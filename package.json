{
  "name": "luzsintrampa",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @lst/web",
    "build": "npm run build -w @lst/web",
    "preview": "npm run preview -w @lst/web",
    "test": "vitest run",
    "precios": "node scripts/fetch-precios.mjs",
    "typecheck": "tsc -p tsconfig.check.json",
    "autocompletado": "node scripts/autocompletado.mjs",
    "tarifas": "node scripts/importar-cnmc.mjs",
    "desplegar": "npm run build && npm run deploy -w @lst/worker",
    "db:init": "npm run db:init -w @lst/worker",
    "seo": "node scripts/auditar-seo.mjs",
    "precios:global": "node scripts/precios-global.mjs",
    "build:global": "npm run build -w @lst/global",
    "seo:global": "node scripts/auditar-seo.mjs apps/global/dist",
    "desplegar:global": "npm run build:global && npm run deploy -w @lst/worker-global"
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "vitest": "^5.0.5"
  }
}
