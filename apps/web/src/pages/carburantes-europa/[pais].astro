---
// Precio de la gasolina, el diésel, el gasóleo de calefacción y el GLP en un país de la UE, comparado con España.
import Base from "../../layouts/Base.astro";
import Anuncio from "../../components/Anuncio.astro";
import { esquemaFaq } from "../../lib/faq";
import { fechaMedia } from "../../lib/formato";
import { slug } from "../../lib/ranking";
import { graficaLineas } from "../../lib/compartido/grafica-svg";
import { PAISES_UE, ranking, ultimo, ultimas, nombrePais, partImpuestos, FUENTE_UE, type ProductoUE } from "../../lib/compartido/carburantes-ue";

export function getStaticPaths() {
  return PAISES_UE.filter((cc) => cc !== "ES").map((cc) => ({ params: { pais: slug(nombrePais(cc, "es")) }, props: { cc } }));
}
const { cc } = Astro.props as { cc: string };
const nombre = nombrePais(cc, "es");
const eur = (n: number) => `${n.toLocaleString("es-ES", { minimumFractionDigits: 3, maximumFractionDigits: 3 })} €/l`;
const cts = (n: number) => `${Math.abs(n * 100).toLocaleString("es-ES", { maximumFractionDigits: 1 })} céntimos`;
const NOMBRES: Record<ProductoUE, string> = { euro95: "Gasolina 95", diesel: "Diésel", calefaccion: "Gasóleo de calefacción", glp: "GLP (autogás)" };
const prods = (Object.keys(NOMBRES) as ProductoUE[]).filter((p) => ultimo(cc, p));
const g = ultimo(cc, "euro95")!;
const gES = ultimo("ES", "euro95")!;
const d = ultimo(cc, "diesel");
const dES = ultimo("ES", "diesel")!;
const semana = fechaMedia(g.semana);
const puestoG = ranking("euro95").findIndex((x) => x.cc === cc) + 1;
const total = ranking("euro95").length;
const imp = partImpuestos(cc, "euro95");
const sG = ultimas(cc, "euro95", 156);
const sES = ultimas("ES", "euro95", 156);
const mesCorto = (f: string) => new Date(`${f}T12:00:00Z`).toLocaleDateString("es-ES", { month: "short", year: "numeric" });
const comp = (a: number, b: number) => (Math.abs(a - b) < 0.005 ? "lo mismo que en España" : `${cts(a - b)} ${a > b ? "más" : "menos"} que en España`);
const preguntas = [
  { p: `¿Cuánto cuesta la gasolina en ${nombre}?`, r: `En la semana del ${semana}, la gasolina 95 cuesta de media ${eur(g.valor)} en ${nombre}: ${comp(g.valor, gES.valor)}. Llenar un depósito de 50 litros sale ${Math.abs((g.valor - gES.valor) * 50).toLocaleString("es-ES", { maximumFractionDigits: 2 })} € ${g.valor > gES.valor ? "más caro" : "más barato"}.` },
  ...(d ? [{ p: `¿Cuánto cuesta el diésel en ${nombre}?`, r: `El gasóleo de automoción cuesta ${eur(d.valor)} de media: ${comp(d.valor, dES.valor)}.` }] : []),
  { p: `¿Conviene llenar el depósito antes de entrar en ${nombre}?`, r: g.valor > gES.valor + 0.03 ? `Sí: la gasolina es más cara que en España, así que conviene salir con el depósito lleno y repostar lo justo allí.` : g.valor < gES.valor - 0.03 ? `No: en ${nombre} la gasolina es más barata que en España, así que compensa repostar allí.` : `Da casi igual: el precio es muy parecido al de España. Fíjate más en la gasolinera concreta (las de autopista son más caras).` },
  ...(imp ? [{ p: `¿Qué parte del precio son impuestos en ${nombre}?`, r: `Los impuestos (impuesto especial e IVA) son el ${Math.round(imp * 100)} % del precio de la gasolina en ${nombre}, frente al ${Math.round((partImpuestos("ES", "euro95") ?? 0) * 100)} % en España.` }] : []),
];
const titulo = `Precio de la gasolina en ${nombre}: ${eur(g.valor)} (${semana.replace(/ de \d{4}$/, "")})`;
---

<Base
  titulo={titulo.length <= 70 ? titulo : `Precio de la gasolina en ${nombre}: ${eur(g.valor)}`}
  descripcion={`Gasolina 95 a ${eur(g.valor)}${d ? ` y diésel a ${eur(d.valor)}` : ""} en ${nombre} (semana del ${semana}). Comparado con España y evolución de los últimos tres años.`.slice(0, 160)}
  schema={esquemaFaq(preguntas)}
  migas={[["Carburantes en Europa", "/carburantes-europa/"], [nombre]]}
>
  <section class="hero hero--compacto">
    <div class="wrap">
      <p class="breadcrumbs"><a href="/carburantes-europa/">Carburantes en Europa</a> / {nombre}</p>
      <h1>Precio de la gasolina y el diésel en {nombre}</h1>
      <p class="lead">Semana del {semana}. La gasolina 95 cuesta <strong>{eur(g.valor)}</strong> en {nombre}, {comp(g.valor, gES.valor)}. Es el país {puestoG} de {total} de la UE (1 = el más barato).</p>
    </div>
  </section>
  <section class="section section--tight">
    <div class="wrap stack" style="--stack:32px">
      <div class="grid grid--4 stats">
        {prods.map((p) => {
          const u = ultimo(cc, p)!;
          const e = ultimo("ES", p);
          return (
            <div class="stat">
              <span class="stat__label">{NOMBRES[p]}</span>
              <span class="stat__value">{eur(u.valor).replace(" €/l", "")}<small> €/l</small></span>
              <span class="stat__sub">{e ? `España: ${eur(e.valor)}` : ""}</span>
            </div>
          );
        })}
      </div>
      <div>
        <h2 style="font-size:22px;margin-bottom:12px">Gasolina 95 en {nombre} y en España, últimos tres años</h2>
        <Fragment set:html={graficaLineas([{ nombre, valores: sG.valores }, { nombre: "España", valores: sES.valores }], { etiquetas: sG.fechas.map(mesCorto), formato: (n) => n.toFixed(2).replace(".", ","), resumen: `Precio semanal de la gasolina 95 en ${nombre} y en España` })} />
        <p class="caption">€/litro con impuestos. Fuente: <a href={FUENTE_UE.url} rel="noopener">Comisión Europea, Boletín Petrolero semanal</a>.</p>
      </div>
    </div>
  </section>
  <Anuncio tipo="horizontal" seccion />
  <section class="section section--white">
    <div class="wrap wrap--narrow">
      <h2 style="font-size:24px;margin-bottom:12px">Preguntas frecuentes</h2>
      {preguntas.map((q) => (
        <details class="faq-c">
          <summary>{q.p}</summary>
          <p>{q.r}</p>
        </details>
      ))}
      <p class="small" style="margin-top:16px"><a href="/carburantes-europa/">Todos los países de Europa</a> · <a href="/gasolineras-baratas/">gasolineras baratas en España</a> · <a href="/guias/ahorrar-gasolina/">cómo gastar menos gasolina en viaje</a></p>
    </div>
  </section>
</Base>

<style>
  .faq-c {
    border-bottom: 1px solid var(--color-pale-sage);
    padding: 6px 0;
  }
  .faq-c summary {
    color: var(--color-bark);
  }
  .faq-c p {
    padding: 4px 0 12px 20px;
  }
</style>
