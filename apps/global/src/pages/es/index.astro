---
// Portada de España en la web global: carburantes (precio de hoy, mapa, gasolineras baratas, Europa) y guías.
// El precio de la luz de España está en la web española (comparadortarifaluz.es), a la que se enlaza.
import Base from "../../layouts/Base.astro";
import { HAY_GASOLINERAS, ESTACIONES, FECHA, HORA, PROVINCIAS, stats, eurL } from "../../lib/gasolineras";
import { PAISES } from "../../lib/datos";
import { urlCalefaccion, urlEuropa } from "../../lib/carburantes";
import { urlMapa, estaciones } from "../../lib/mapa";
import { guiasDe, urlGuia } from "../../lib/guias";
import { SITIO } from "../../config";
import { fechaMedia } from "../../../../web/src/lib/formato";

const es = PAISES.find((p) => p.cc === "es")!;
const g = HAY_GASOLINERAS ? stats(ESTACIONES, "g95") : null;
const d = HAY_GASOLINERAS ? stats(ESTACIONES, "diesel") : null;
const n = estaciones("ES")?.e.length ?? ESTACIONES.length;
const tarjetas = [
  { href: "/es/precio-gasolina-hoy/", t: "Precio de la gasolina hoy", d: g ? `Gasolina 95 a ${eurL(g.media)} de media. Las más baratas de España y la evolución diaria.` : "La media de España, las más baratas y la evolución diaria." },
  { href: "/es/precio-gasoil-hoy/", t: "Precio del gasoil hoy", d: d ? `Diésel a ${eurL(d.media)} de media, por provincias y gasolineras.` : "Lo que cuesta hoy el diésel, por provincias y gasolineras." },
  { href: urlMapa(es), t: "Mapa de gasolineras", d: `Las ${n.toLocaleString("es-ES")} gasolineras de España en el mapa, con buscador y las más baratas cerca de ti.` },
  { href: "/es/gasolineras-baratas/", t: "Gasolineras baratas por provincia", d: `Las ${PROVINCIAS.length} provincias, municipio a municipio, con el precio de cada gasolinera.` },
  { href: "/es/precio-glp-hoy/", t: "Precio del GLP (autogás)", d: "El GLP más barato y las gasolineras que lo venden." },
  { href: urlEuropa(es), t: "Gasolina en Europa", d: "Lo que cuesta el litro en cada país de la UE frente a España, para tus viajes." },
  { href: urlCalefaccion(es), t: "Gasóleo de calefacción", d: "Precio semanal del gasóleo C y cuánto cuestan 1.000 litros." },
  { href: SITIO.espana, t: "Precio de la luz hoy", d: "Hora a hora, en ComparadorTarifaLuz.es, nuestra web de la luz en España." },
];
const desc = g && d ? `Precio de la gasolina y el gasóleo hoy en España (gasolina 95 a ${eurL(g.media)}, diésel a ${eurL(d.media)}), mapa de gasolineras y las más baratas de cada provincia.` : "Precio de la gasolina y el gasóleo hoy en España, mapa de gasolineras y las más baratas de cada provincia.";
---

<Base titulo="Gasolina y gasóleo en España: precios de hoy y mapa de gasolineras" descripcion={desc.length <= 160 ? desc : desc.slice(0, desc.lastIndexOf(",")) + "."} lang="es" locale="es-ES">
  <section class="hero hero--compacto">
    <div class="wrap">
      {HAY_GASOLINERAS && <span class="eyebrow">Actualizado {fechaMedia(FECHA)} a las {HORA}</span>}
      <h1>Gasolina y gasóleo en España</h1>
      <p class="lead">
        El precio de cada gasolinera de España, actualizado varias veces al día con los datos del Ministerio para la Transición Ecológica.
        {g && d && <> Hoy la gasolina 95 está a <strong>{eurL(g.media)}</strong> y el diésel a <strong>{eurL(d.media)}</strong> de media.</>}
      </p>
      <div class="btn-row">
        <a class="btn btn--mint" href={urlMapa(es)}>Abrir el mapa de gasolineras</a>
        <a class="btn btn--ghost" href="/es/gasolineras-baratas/">Gasolineras baratas en tu provincia</a>
      </div>
    </div>
  </section>
  <section class="section section--tight">
    <div class="wrap grid grid--2">
      {tarjetas.map((x) => <a class="card card--link" href={x.href}><strong>{x.t}</strong><span class="muted small">{x.d}</span></a>)}
    </div>
  </section>
  <section class="section section--white section--tight">
    <div class="wrap">
      <h2 style="font-size:24px;margin-bottom:16px">Guías y consejos</h2>
      <div class="grid grid--3">
        {guiasDe("es").map((x) => <a class="card card--link" href={urlGuia(x)}><strong>{x.titulo}</strong><span class="muted small">{x.resumen}</span></a>)}
      </div>
    </div>
  </section>
</Base>
