---
// Carburantes en el idioma de cada país: precios del país (/de/spritpreise/), gasóleo de calefacción
// (/de/heizoelpreise/) y ranking europeo (/de/spritpreise-europa/). Datos semanales de la Comisión Europea.
import Base from "../../layouts/Base.astro";
import Anuncio from "../../components/Anuncio.astro";
import { guiasDe, urlGuia, TITULO_GUIAS } from "../../lib/guias";
import { graficaLineas } from "../../../../web/src/lib/compartido/grafica-svg";
import { ultimo, ultimas, ranking, partImpuestos, nombrePais, FUENTE_UE, type ProductoUE } from "../../../../web/src/lib/compartido/carburantes-ue";
import { PAISES_C, textosC, CC, urlPrecios, urlCalefaccion, urlEuropa, urlDestino, en, litro, dinero, pct, fechaC, mesC, VECINOS, PRODUCTOS, hay, preciosPropios } from "../../lib/carburantes";
import { lista, semanaIso } from "../../lib/textos-carburantes";
import { tieneMapas, urlMapa } from "../../lib/mapa";
import { TEXTOS_M } from "../../lib/textos-mapa";
import TablaRegiones from "../../components/TablaRegiones.astro";
import { zonasDe, urlZonas, cifras, continental, eurZ, fechaZ } from "../../lib/zonas";
import { TEXTOS } from "../../lib/textos";
import type { Pais } from "../../lib/datos";
import { esquemaFaq, MERCADOS, recortarFrases } from "../../lib/datos";

type Seccion = "precios" | "calefaccion" | "europa";
export function getStaticPaths() {
  return PAISES_C.flatMap((p) => {
    const T = textosC(p);
    return [
      ...(preciosPropios(p) ? [] : [{ params: { pais: p.cc, seccion: T.slugPrecios }, props: { p, s: "precios" as Seccion } }]),
      ...(hay(CC(p), "calefaccion") ? [{ params: { pais: p.cc, seccion: T.slugCalefaccion }, props: { p, s: "calefaccion" as Seccion } }] : []),
      { params: { pais: p.cc, seccion: T.slugEuropa }, props: { p, s: "europa" as Seccion } },
    ];
  });
}
const { p, s } = Astro.props as { p: Pais; s: Seccion };
const T = textosC(p);
const L = TEXTOS[p.lang];
const cc = CC(p);
const nombre = nombrePais(cc, p.locale);
const enP = en(p, cc);
const g = ultimo(cc, "euro95")!;
const semana = T.semanaDel(fechaC(p, g.semana), semanaIso(g.semana));
const rk = ranking("euro95");
const puesto = rk.findIndex((x) => x.cc === cc) + 1;
const imp = partImpuestos(cc, "euro95");
const sep = p.lang === "fr" ? " : " : ": ";
const flecha = (a: number, b: number | null) => (b === null ? "" : a > b + 0.0005 ? "▲" : a < b - 0.0005 ? "▼" : "=");
const prods = PRODUCTOS.filter((k) => hay(cc, k));
const vecinos = (VECINOS[cc] ?? []).filter((x) => hay(x, "euro95"));

// Gasóleo de calefacción: mes más barato de los tres últimos años.
const sCal = ultimas(cc, "calefaccion", 156);
const porMes = new Map<number, number[]>();
sCal.fechas.forEach((f, i) => sCal.valores[i] != null && porMes.set(Number(f.slice(5, 7)), [...(porMes.get(Number(f.slice(5, 7))) ?? []), sCal.valores[i]!]));
const mesBarato = [...porMes.entries()].map(([m, v]) => ({ m, media: v.reduce((a, b) => a + b, 0) / v.length })).sort((a, b) => a.media - b.media)[0];
const nombreMes = (m: number) => new Intl.DateTimeFormat(p.locale, { month: "long", timeZone: "UTC" }).format(new Date(Date.UTC(2026, m - 1, 15)));
const cal = ultimo(cc, "calefaccion");

const top3 = lista(p.lang, rk.slice(0, 3).map((x) => en(p, x.cc)), T.y);
const lead =
  s === "precios"
    ? T.leadPais({ enP, precio: litro(p, g.valor), puesto, total: rk.length, imp: imp ? pct(p, imp) : null })
    : s === "calefaccion" && cal
      ? T.leadCal({ enP, precio: litro(p, cal.valor), mil: dinero(p, cal.valor * 1000) })
      : "";
const preguntas =
  s === "calefaccion" && cal
    ? [
        { p: T.pCal(enP), r: T.rCal({ enP, precio: litro(p, cal.valor), semana, mil: dinero(p, cal.valor * 1000) }) },
        ...(mesBarato ? [{ p: T.pCuandoCal, r: T.rCuandoCal(nombreMes(mesBarato.m)) }] : []),
      ]
    : [
        { p: T.pPrecio(enP), r: T.rPrecio({ enP, precio: litro(p, g.valor), semana, puesto, total: rk.length }) },
        ...(hay(cc, "diesel") ? [{ p: T.pDiesel(enP), r: T.rDiesel({ enP, precio: litro(p, ultimo(cc, "diesel")!.valor), semana }) }] : []),
        ...(imp ? [{ p: T.pImpuestos(enP), r: T.rImpuestos(enP, pct(p, imp)) }] : []),
        { p: T.pBarato, r: T.rBarato(top3, en(p, rk.at(-1)!.cc)) },
      ];
const titulo =
  s === "precios" ? `${T.tituloPais(enP)}${sep}${T.productos.euro95} ${litro(p, g.valor)}` : s === "calefaccion" ? `${T.tituloCalefaccion(enP)}${sep}${litro(p, cal!.valor)}` : `${T.tituloEuropa} (${semana})`;
const desc =
  s === "europa"
    ? recortarFrases(`${T.rBarato(top3, en(p, rk.at(-1)!.cc))} (${semana})`.length <= 158 ? `${T.rBarato(top3, en(p, rk.at(-1)!.cc))} (${semana})` : T.rBarato(top3, en(p, rk.at(-1)!.cc)), 158)
    : recortarFrases(`${lead} (${semana})`.length <= 158 ? `${lead} (${semana})` : lead, 158);
const recorta = (t: string, n: number) => (t.length <= n ? t : t.slice(0, t.lastIndexOf(" ", n - 1)) + "…");
const serie = (k: ProductoUE, c = cc) => ultimas(c, k, 156);
// Países con mapa y páginas por región: el precio de hoy en sus gasolineras y la media de cada región.
const z = s === "precios" ? zonasDe(p) : null;
const hoyZ = z ? z.orden.map((k) => ({ k, s: cifras(z, continental(z), k) })).filter((x) => x.s && x.s.n >= 50) : [];
---

<Base titulo={recorta(titulo, 70)} descripcion={recorta(desc, 158)} lang={p.lang} locale={p.locale} schema={esquemaFaq(preguntas)}>
  <section class="hero hero--compacto">
    <div class="wrap">
      <span class="eyebrow">{p.nombre} · {semana}</span>
      <h1>{s === "precios" ? T.tituloPais(enP) : s === "calefaccion" ? T.tituloCalefaccion(enP) : T.tituloEuropa}</h1>
      {lead && <p class="lead">{lead}</p>}
      <div class="btn-row">
        <a class="btn btn--ghost btn--small" href={urlPrecios(p)} aria-current={s === "precios" ? "page" : undefined}>{T.productos.euro95} / {T.productos.diesel}</a>
        {hay(cc, "calefaccion") && <a class="btn btn--ghost btn--small" href={urlCalefaccion(p)} aria-current={s === "calefaccion" ? "page" : undefined}>{T.productos.calefaccion}</a>}
        <a class="btn btn--ghost btn--small" href={urlEuropa(p)} aria-current={s === "europa" ? "page" : undefined}>{T.tituloEuropa}</a>
        {tieneMapas(p) && <a class="btn btn--ghost btn--small" href={urlMapa(p)}>{TEXTOS_M[p.lang]!.boton}</a>}
        {MERCADOS.some((m) => m.pais.cc === p.cc) && <a class="btn btn--ghost btn--small" href={`/${p.cc}/`}>{L.precio} {L.hoy}</a>}
      </div>
    </div>
  </section>

  {
    z && hoyZ.length > 0 && (
      <section class="section section--white section--tight">
        <div class="wrap stack" style="--stack:16px">
          <h2 style="font-size:24px">{z.T.hoyT}</h2>
          <div class="grid grid--4 stats">
            {hoyZ.slice(0, 4).map(({ k, s: x }) => (
              <div class="stat">
                <span class="stat__label">{TEXTOS_M[p.lang]!.comb[k]}</span>
                <span class="stat__value" style="font-size:28px">{eurZ(z, x!.media)}</span>
                <span class="stat__sub">{TEXTOS_M[p.lang]!.statMin(TEXTOS_M[p.lang]!.comb[k])}: {eurZ(z, x!.min)}</span>
              </div>
            ))}
          </div>
          <p class="caption">{z.T.hoyLead({ n: new Intl.NumberFormat(p.locale).format(continental(z).length), fecha: fechaZ(z, z.actualizado) })}</p>
          <h3 style="font-size:20px">{z.T.regionesT}</h3>
          <TablaRegiones z={z} />
          <div class="btn-row">
            <a class="btn btn--mint" href={urlZonas(z)}>{z.T.hubH1}</a>
            {tieneMapas(p) && <a class="btn btn--ghost" href={urlMapa(p)}>{TEXTOS_M[p.lang]!.boton}</a>}
          </div>
        </div>
      </section>
    )
  }

  {
    s === "precios" && (
      <section class="section section--tight">
        <div class="wrap stack" style="--stack:32px">
          <div class="grid grid--4 stats">
            {prods.map((k) => {
              const u = ultimo(cc, k)!;
              return (
                <div class="stat">
                  <span class="stat__label">{T.productos[k]}</span>
                  <span class="stat__value" style="font-size:28px">{litro(p, u.valor)}</span>
                  <span class="stat__sub">{flecha(u.valor, u.anterior)} {T.semanaAnterior}{sep}{u.anterior ? litro(p, u.anterior) : "—"}{u.haceUnAno ? ` · ${T.haceUnAno}${sep}${litro(p, u.haceUnAno)}` : ""}</span>
                </div>
              );
            })}
          </div>
          <div>
            <h2 style="font-size:22px;margin-bottom:12px">{T.tresAnos}</h2>
            <Fragment set:html={graficaLineas([{ nombre: T.productos.euro95, valores: serie("euro95").valores.map((v) => v) }, { nombre: T.productos.diesel, valores: serie("diesel").valores }], { etiquetas: serie("euro95").fechas.map((f) => mesC(p, f)), formato: (n) => litro(p, n, 2).replace(/[\s\u00a0].*$/, ""), resumen: `${T.tituloPais(enP)}, ${T.tresAnos}` })} />
            <p class="caption">{T.fuente}</p>
          </div>
        </div>
      </section>
    )
  }

  {
    s === "calefaccion" && cal && (
      <section class="section section--tight">
        <div class="wrap stack" style="--stack:32px">
          <div class="grid grid--4 stats">
            <div class="stat"><span class="stat__label">{T.productos.calefaccion}</span><span class="stat__value" style="font-size:28px">{litro(p, cal.valor)}</span><span class="stat__sub">{flecha(cal.valor, cal.anterior)} {T.semanaAnterior}{sep}{cal.anterior ? litro(p, cal.anterior) : "—"}</span></div>
            <div class="stat"><span class="stat__label">500 l</span><span class="stat__value" style="font-size:28px">{dinero(p, cal.valor * 500)}</span><span class="stat__sub"></span></div>
            <div class="stat"><span class="stat__label">{T.litros1000}</span><span class="stat__value" style="font-size:28px">{dinero(p, cal.valor * 1000)}</span><span class="stat__sub"></span></div>
            <div class="stat"><span class="stat__label">{T.haceUnAno}</span><span class="stat__value" style="font-size:28px">{cal.haceUnAno ? litro(p, cal.haceUnAno) : "—"}</span><span class="stat__sub"></span></div>
          </div>
          <div>
            <h2 style="font-size:22px;margin-bottom:12px">{T.tresAnos}</h2>
            <Fragment set:html={graficaLineas([{ nombre: nombre, valores: sCal.valores }, { nombre: nombrePais("EU", p.locale), valores: serie("calefaccion", "EU").valores }], { etiquetas: sCal.fechas.map((f) => mesC(p, f)), formato: (n) => litro(p, n, 2).replace(/[\s\u00a0].*$/, ""), resumen: `${T.tituloCalefaccion(enP)}, ${T.tresAnos}` })} />
            <p class="caption">{T.fuente}</p>
          </div>
        </div>
      </section>
    )
  }

  {
    s === "europa" && (
      <section class="section section--tight">
        <div class="wrap grid grid--2" style="gap:32px">
          {(["euro95", "diesel"] as ProductoUE[]).map((k) => {
            const r = ranking(k);
            const casa = ultimo(cc, k);
            return (
              <div>
                <h2 style="font-size:22px;margin-bottom:12px">{T.productos[k]}</h2>
                <div class="table-wrap" tabindex="0" role="region" aria-label={T.productos[k]}>
                  <table class="tabla-precios">
                    <thead><tr><th scope="col">{T.pais}</th><th scope="col" class="num">{T.porLitro}</th><th scope="col" class="num">{nombre}</th></tr></thead>
                    <tbody>
                      {r.map((x, i) => {
                        const dif = casa ? x.u.valor - casa.valor : 0;
                        return (
                          <tr class={x.cc === cc ? "mejor" : undefined}>
                            <td>{i + 1}. {x.cc === cc ? nombre : <a href={urlDestino(p, x.cc)}>{nombrePais(x.cc, p.locale)}</a>}</td>
                            <td class="num">{litro(p, x.u.valor)}</td>
                            <td class={`num ${dif > 0 ? "sube" : dif < 0 ? "baja" : ""}`}>{x.cc === cc ? "—" : `${dif > 0 ? "+" : "−"}${litro(p, Math.abs(dif), p.moneda === "EUR" ? 2 : 2)}`}</td>
                          </tr>
                        );
                      })}
                    </tbody>
                  </table>
                </div>
              </div>
            );
          })}
          <p class="caption">{T.fuente}</p>
        </div>
      </section>
    )
  }

  <Anuncio tipo="horizontal" seccion />

  {
    s === "precios" && vecinos.length > 0 && (
      <section class="section section--white section--tight">
        <div class="wrap wrap--narrow">
          <h2 style="font-size:22px;margin-bottom:12px">{T.vecinos}</h2>
          <div class="table-wrap" tabindex="0" role="region" aria-label={T.vecinos}>
            <table class="tabla-precios">
              <thead><tr><th scope="col">{T.pais}</th><th scope="col" class="num">{T.productos.euro95}</th><th scope="col" class="num">{T.productos.diesel}</th></tr></thead>
              <tbody>
                <tr class="mejor"><td><strong>{nombre}</strong></td><td class="num">{litro(p, g.valor)}</td><td class="num">{hay(cc, "diesel") ? litro(p, ultimo(cc, "diesel")!.valor) : "—"}</td></tr>
                {vecinos.map((v) => (
                  <tr>
                    <td><a href={urlDestino(p, v)}>{nombrePais(v, p.locale)}</a></td>
                    <td class="num">{litro(p, ultimo(v, "euro95")!.valor)}</td>
                    <td class="num">{hay(v, "diesel") ? litro(p, ultimo(v, "diesel")!.valor) : "—"}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      </section>
    )
  }

  <section class="section section--white">
    <div class="wrap wrap--narrow">
      <h2 style="font-size:22px;margin-bottom:12px">{s === "calefaccion" ? T.consejosCalT : T.consejosT}</h2>
      <ul class="g-consejos">
        {(s === "calefaccion" ? T.consejosCalefaccion : T.consejosCarburante).map((c) => <li>{c}</li>)}
      </ul>
      <h2 style="font-size:22px;margin:32px 0 12px">{T.preguntasT}</h2>
      {preguntas.map((q) => (
        <details class="g-faq">
          <summary>{q.p}</summary>
          <p>{q.r}</p>
        </details>
      ))}
      <p class="caption" style="margin-top:16px">{s === "calefaccion" ? T.avisoCal : T.aviso} <a href={FUENTE_UE.url} rel="noopener">{T.fuenteNombre}</a></p>
    </div>
  </section>

{
  guiasDe(p.lang).length > 0 && (
    <section class="section section--tight">
      <div class="wrap">
        <h2 style="font-size:24px;margin-bottom:16px">{TITULO_GUIAS[p.lang]}</h2>
        <div class="grid grid--2">
          {guiasDe(p.lang).map((x) => <a class="card card--link" href={urlGuia(x)}><strong>{x.titulo}</strong><span class="muted small">{x.resumen}</span></a>)}
        </div>
      </div>
    </section>
  )
}
</Base>

<style>
  .g-consejos {
    padding-left: 1.2em;
    display: grid;
    gap: 8px;
  }
  .g-faq {
    border-bottom: 1px solid var(--color-pale-sage);
    padding: 6px 0;
  }
  .g-faq summary {
    color: var(--color-bark);
    cursor: pointer;
  }
  .g-faq p {
    padding: 4px 0 12px 20px;
  }
  .btn[aria-current="page"] {
    background: var(--color-canopy);
    color: #fff;
  }
</style>
