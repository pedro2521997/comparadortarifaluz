---
import Base from "../layouts/Base.astro";
import Anuncio from "../components/Anuncio.astro";
import PrecioDia from "../components/PrecioDia.astro";
import AvisoDiario from "../components/AvisoDiario.astro";
import ExtrasDia from "../components/ExtrasDia.astro";
import ComparaDias from "../components/ComparaDias.astro";
import PlanDia from "../components/PlanDia.astro";
import MasSobrePrecio from "../components/MasSobrePrecio.astro";
import { hoyMadrid, fechaLarga, sumarDias, fechaCorta } from "../lib/formato";
import { preciosDe } from "../lib/datos";
import { infoDia, tituloDia, descripcionDia } from "../lib/dia";
import { entradillaVivo, preguntasVivo, compararDias, rotulo } from "../lib/dia-vivo";
import { esquemaFaq } from "../lib/faq";
import { alternativas } from "../lib/hreflang";

const hoy = hoyMadrid();
const hayManana = preciosDe(sumarDias(hoy, 1)) !== null;
// Títulos con el dato del día: es lo que busca la gente y lo que hace clicar. El build se repite
// cada noche a las 00:05 para que la fecha que ve Google sea siempre la de hoy.
const i = infoDia(hoy);
const titulo = i ? tituloDia(i, "hoy") : "Precio de la luz hoy por horas (PVPC)";
const descripcion = i
  ? descripcionDia(i, "hoy")
  : "Precio de la luz de hoy hora a hora, las horas más baratas para poner la lavadora, el lavavajillas o cargar el coche, con datos de Red Eléctrica.";
// Sin el Dataset del día: ese lo lleva la página fija de la fecha. Aquí, solo las preguntas propias de «hoy».
const schema = i ? [esquemaFaq(preguntasVivo(i, "hoy"))] : undefined;
const ayer = sumarDias(hoy, -1);
const semana = sumarDias(hoy, -7);
const comp = compararDias([[semana, rotulo("Hace 7 días", semana)], [ayer, rotulo("Ayer", ayer)], [hoy, rotulo("Hoy", hoy)]], ayer, hoy, "Hoy, frente a ayer,");
---

<Base titulo={titulo} descripcion={descripcion} schema={schema} alternativas={alternativas("hoy")} migas={[["Precio de la luz", "/precio-luz/"], ["Hoy"]]}>
  <section class="hero hero--compacto">
    <div class="wrap">
      <span class="eyebrow">Precio de la luz hoy</span>
      <h1>Precio de la luz hoy, <span data-fecha-texto>{fechaLarga(hoy)}</span></h1>
      {i ? <p class="lead" data-dia-fijo={hoy}>{entradillaVivo(i, "hoy")}</p> : <p class="lead">Tarifa regulada (PVPC) hora a hora, con datos de Red Eléctrica.</p>}
      <div class="btn-row">
        <a class="btn btn--ghost" href="/precio-luz-manana/">{hayManana ? "Ya está el precio de mañana" : "Precio de mañana"}</a>
        <a class="btn btn--ghost" href="/precio-luz-ayer/">Ayer</a>
        <a class="btn btn--ghost" href="/precio-luz/">Días anteriores</a>
      </div>
    </div>
  </section>
  <section class="section section--tight">
    <div class="wrap">
      <PrecioDia fecha={hoy} modo="hoy" />
      {i && <p class="caption" data-dia-fijo={hoy} style="margin-top:12px">Por qué la luz cuesta esto hoy y cómo queda en el mes: <a href={`/precio-luz/${hoy}/`}>análisis del {fechaCorta(hoy)}</a>.</p>}
    </div>
  </section>
  <Anuncio tipo="horizontal" seccion />
  {i && <PlanDia i={i} modo="hoy" />}
  <ComparaDias c={comp} titulo="Hoy frente a ayer y la semana pasada" fecha={hoy} />
  <ExtrasDia modo="hoy" />
  <Anuncio tipo="horizontal" seccion />
  <MasSobrePrecio fecha={hoy} vivo />
  <AvisoDiario />
</Base>
