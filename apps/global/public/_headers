# Cabeceras de la web estática (Cloudflare Workers Static Assets). Este fichero no se publica como página.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=(self), payment=()
  # Una vez visitada por HTTPS, el navegador ya no vuelve a pedir la web por http:// durante un año.
  Strict-Transport-Security: max-age=31536000

# Ficheros con huella en el nombre: no cambian nunca, se pueden guardar un año.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable


# La dirección de pruebas *.workers.dev no debe aparecer en Google (el sitio bueno es powerpricenow.com).
https://:worker.:cuenta.workers.dev/*
  X-Robots-Tag: noindex

# Gasolineras de los mapas: cambian varias veces al día. El navegador las guarda cinco minutos y, pasado ese
# tiempo, enseña la copia guardada mientras comprueba si hay una nueva.
/data/gasolineras/*
  Cache-Control: public, max-age=300, stale-while-revalidate=3600

# Icono y logotipo: cambian muy poco.
/favicon.svg
  Cache-Control: public, max-age=604800
/logo.png
  Cache-Control: public, max-age=604800
