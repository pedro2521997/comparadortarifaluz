---
import Base from "../../layouts/Base.astro";
import { guias, preguntas } from "../../lib/guias";
import { fechaMedia } from "../../lib/formato";

export function getStaticPaths() {
  return guias.map((g) => ({ params: { slug: g.slug }, props: { g } }));
}
const { g } = Astro.props as { g: (typeof guias)[number] };
const { Content } = g.md;
const otras = guias.filter((x) => x.slug !== g.slug).slice(0, 3);

const schema = g.faq
  ? {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      mainEntity: preguntas(g.md).map((p) => ({ "@type": "Question", name: p.q, acceptedAnswer: { "@type": "Answer", text: p.a } })),
    }
  : {
      "@context": "https://schema.org",
      "@type": g.howto ? "HowTo" : "Article",
      [g.howto ? "name" : "headline"]: g.titulo,
      description: g.resumen,
      dateModified: g.revisado,
      inLanguage: "es-ES",
    };
---

<Base titulo={g.titulo} descripcion={g.resumen} schema={schema}>
  <section class="hero hero--compacto">
    <div class="wrap wrap--narrow">
      <p class="breadcrumbs"><a href="/guias/">Guías</a></p>
      <h1 class="guia-h1">{g.titulo}</h1>
      <p class="lead">{g.resumen}</p>
      <p class="caption" style="margin-top:16px">Revisada el {fechaMedia(g.revisado)}</p>
    </div>
  </section>
  <section class="section section--white section--tight">
    <div class="wrap wrap--narrow">
      <article class="prose">
        <Content />
      </article>

      <div class="card card--roomy guia-cta">
        <span class="eyebrow">Pásalo a números</span>
        <p class="guia-cta__t">{g.herramienta.texto}</p>
        <a class="btn" href={g.herramienta.href}>Ir a la herramienta</a>
      </div>

      <div class="fuentes-guia">
        <h2 class="eyebrow">Fuentes</h2>
        <ul class="small">
          {g.fuentes.map((f) => <li><a href={f.url} rel="noopener">{f.nombre}</a></li>)}
        </ul>
      </div>
    </div>
  </section>
  <section class="section section--tight">
    <div class="wrap wrap--narrow">
      <h2 style="font-size:28px;margin-bottom:16px">Sigue leyendo</h2>
      <div class="grid">
        {otras.map((o) => <a class="card card--link" href={`/guias/${o.slug}/`}><strong>{o.titulo}</strong><span class="muted small">{o.resumen}</span></a>)}
      </div>
    </div>
  </section>
</Base>

<style>
  .guia-h1 {
    font-size: clamp(32px, 6vw, 48px);
  }
  .guia-cta {
    margin-top: 48px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    align-items: flex-start;
    background: var(--color-cream-paper);
  }
  .guia-cta__t {
    font-size: 24px;
    font-weight: 300;
    color: var(--color-ink);
  }
  .fuentes-guia {
    margin-top: 40px;
  }
  .fuentes-guia ul {
    margin-top: 8px;
    padding-left: 1.2em;
  }
</style>
