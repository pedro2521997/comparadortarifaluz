---
import Base from "../layouts/Base.astro";
---

<Base titulo="Página no encontrada" noindex anuncioFinal={false}>
  <section class="hero">
    <div class="wrap center stack" style="--stack:16px">
      <span class="eyebrow">Error 404</span>
      <h1>Aquí no hay luz</h1>
      <p class="lead">La página que buscas no existe o ha cambiado de sitio.</p>
      <div class="btn-row">
        <a class="btn" href="/">Ir al inicio</a>
        <a class="btn btn--ghost" href="/precio-luz-hoy/">Precio de la luz hoy</a>
      </div>
    </div>
  </section>
</Base>
