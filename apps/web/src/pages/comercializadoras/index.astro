---
import Base from "../../layouts/Base.astro";
import Anuncio from "../../components/Anuncio.astro";
import Tarjeta from "../../components/Tarjeta.astro";
import { ESCENARIOS, filaDe, marcas, urlMarca, tipoTexto } from "../../lib/catalogo";
import { logoGrande, nombrePlan } from "../../lib/ranking";
import { eur } from "../../lib/formato";
import { SITIO } from "../../config";

const medio = ESCENARIOS[1];
const lista = marcas()
  .map((m) => ({ m, mejor: m.tarifas.map((t) => filaDe(t, medio)).sort((a, b) => a.anual - b.anual)[0] }))
  .sort((a, b) => a.mejor.anual - b.mejor.anual);
const resumenMarca = (m: (typeof lista)[number]["m"]) => ({
  tipos: [...new Set(m.tarifas.map((t) => tipoTexto(t)))],
  permanencia: m.tarifas.filter((t) => t.permanencia_meses > 0).length,
  verdes: m.tarifas.filter((t) => t.info?.verde).length,
});
const schema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: "Comercializadoras de luz en España",
  itemListElement: lista.map(({ m }, i) => ({ "@type": "ListItem", position: i + 1, name: m.marca, url: new URL(urlMarca(m.marca), SITIO.url).href })),
};
---

<Base
  titulo="Compañías de luz en España: todas sus tarifas y precios"
  descripcion={`Las ${lista.length} comercializadoras de luz del catálogo ordenadas por su tarifa más barata para un hogar medio, con todas sus tarifas y precios.`}
  schema={schema}
  migas={[["Comercializadoras"]]}
>
  <section class="hero hero--compacto">
    <div class="wrap">
      <span class="eyebrow">Comercializadoras</span>
      <h1>Todas las compañías de luz y sus tarifas</h1>
      <p class="lead">{lista.length} comercializadoras ordenadas por lo que pagaría un hogar medio con su tarifa más barata. Entra en cada una para ver todas sus tarifas, precios y condiciones.</p>
    </div>
  </section>
  <section class="section section--tight">
    <div class="wrap">
      <p class="muted" style="margin-bottom:16px">Pulsa una compañía para darle la vuelta y ver sus tarifas de un vistazo.</p>
      <ol class="flip-rejilla">
        {
          lista.map(({ m, mejor }, i) => {
            const r = resumenMarca(m);
            return (
              <>
                <li>
                  <Tarjeta etiqueta={m.marca} tono={i < 3 ? "menta" : "blanco"}>
                    <Fragment slot="frente">
                      <span class="cm-pos">{i + 1}º</span>
                      <Fragment set:html={logoGrande(mejor.tarifa)} />
                      <span class="flip__t">{m.marca}</span>
                      <span class="flip__dato">desde <strong>{eur(mejor.anual)}</strong> al año</span>
                    </Fragment>
                    <Fragment slot="dorso">
                      <span class="flip__t">{m.marca}</span>
                      <span class="flip__dato">
                        {m.tarifas.length} {m.tarifas.length === 1 ? "tarifa" : "tarifas"}: {r.tipos.join(", ")}
                      </span>
                      <span class="flip__dato">
                        La más barata: «{nombrePlan(mejor.tarifa.nombre)}»
                      </span>
                      <span class="flip__dato">
                        {r.permanencia ? `${r.permanencia} con permanencia` : "Sin permanencia"}
                        {r.verdes ? ` · ${r.verdes} con energía verde` : ""}
                      </span>
                      <a href={urlMarca(m.marca)}>Ver sus tarifas →</a>
                    </Fragment>
                  </Tarjeta>
                </li>
                {i === 9 && <li class="cm-anuncio"><Anuncio tipo="horizontal" /></li>}
              </>
            );
          })
        }
      </ol>
      <p class="caption" style="margin-top:16px">Hogar medio: 3.000 kWh al año y 4,6 kW, con los precios de cada hora del último año, impuestos incluidos y sin promociones. <a href="/tarifas/">Ver el ranking de todas las tarifas</a></p>
    </div>
  </section>
</Base>

<style>
  .cm-pos {
    position: absolute;
    top: 14px;
    left: 16px;
    font-weight: 600;
    color: var(--color-slate);
    font-variant-numeric: tabular-nums;
  }
  :global(.flip__frente .logo-grande) {
    margin: 22px auto 4px;
  }
  :global(.flip__frente) .flip__t,
  :global(.flip__frente) .flip__dato {
    text-align: center;
  }
  .cm-anuncio {
    grid-column: 1 / -1;
  }
</style>
