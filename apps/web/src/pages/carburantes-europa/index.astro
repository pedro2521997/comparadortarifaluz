---
// Precio de la gasolina y el gasóleo en los países de la UE (semanal, Comisión Europea), del más barato al más caro.
import Base from "../../layouts/Base.astro";
import Anuncio from "../../components/Anuncio.astro";
import { esquemaFaq } from "../../lib/faq";
import { fechaMedia } from "../../lib/formato";
import { slug } from "../../lib/ranking";
import { ranking, ultimo, nombrePais, partImpuestos, ACTUALIZADO, FUENTE_UE, type ProductoUE } from "../../lib/compartido/carburantes-ue";

const eur = (n: number) => `${n.toLocaleString("es-ES", { minimumFractionDigits: 3, maximumFractionDigits: 3 })} €/l`;
const g = ranking("euro95");
const d = ranking("diesel");
const es = (p: ProductoUE) => ultimo("ES", p)!;
const puesto = (r: typeof g) => r.findIndex((x) => x.cc === "ES") + 1;
const url = (cc: string) => (cc === "ES" ? "/precio-gasolina-hoy/" : `/carburantes-europa/${slug(nombrePais(cc, "es"))}/`);
const semana = fechaMedia(ACTUALIZADO);
const preguntas = [
  { p: "¿Cuál es el país de Europa con la gasolina más barata?", r: `En la semana del ${semana}, ${nombrePais(g[0].cc, "es")} (${eur(g[0].u.valor)}), seguido de ${nombrePais(g[1].cc, "es")} y ${nombrePais(g[2].cc, "es")}. La más cara es la de ${nombrePais(g.at(-1)!.cc, "es")} (${eur(g.at(-1)!.u.valor)}).` },
  { p: "¿Es barata la gasolina en España comparada con Europa?", r: `España está en el puesto ${puesto(g)} de ${g.length} en gasolina 95 (${eur(es("euro95").valor)}) y en el ${puesto(d)} en gasóleo (${eur(es("diesel").valor)}), por debajo de la media de la UE gracias a unos impuestos más bajos que en el norte de Europa.` },
  { p: "¿Por qué hay tanta diferencia de precio entre países?", r: `Sobre todo por los impuestos: el impuesto especial sobre hidrocarburos y el IVA suponen entre el 40 y el 60 % del precio. En España son el ${Math.round((partImpuestos("ES", "euro95") ?? 0) * 100)} % del precio de la gasolina.` },
];
---

<Base
  titulo={`Precio de la gasolina y el diésel en Europa (semana del ${semana.replace(/ de \d{4}$/, "")})`}
  descripcion={`Gasolina 95 y diésel en los ${g.length} países de la UE, del más barato al más caro, y cuánto cuestan frente a España. Datos semanales de la Comisión Europea.`}
  schema={esquemaFaq(preguntas)}
  migas={[["Gasolineras baratas", "/gasolineras-baratas/"], ["Carburantes en Europa"]]}
>
  <section class="hero hero--compacto">
    <div class="wrap">
      <span class="eyebrow">Semana del {semana}</span>
      <h1>Precio de la gasolina y el diésel en Europa</h1>
      <p class="lead">¿Vas a viajar en coche? Esto es lo que cuesta el litro en cada país de la UE, con impuestos. España: gasolina 95 a <strong>{eur(es("euro95").valor)}</strong> y diésel a <strong>{eur(es("diesel").valor)}</strong>.</p>
    </div>
  </section>
  <section class="section section--tight">
    <div class="wrap grid grid--2" style="gap:32px">
      {
        [
          { t: "Gasolina 95", r: g },
          { t: "Gasóleo (diésel)", r: d },
        ].map(({ t, r }) => (
          <div>
            <h2 style="font-size:22px;margin-bottom:12px">{t}</h2>
            <div class="table-wrap" tabindex="0" role="region" aria-label={t}>
              <table class="tabla-precios">
                <thead><tr><th scope="col">País</th><th scope="col" class="num">€/litro</th><th scope="col" class="num">vs España</th></tr></thead>
                <tbody>
                  {r.map((x, i) => {
                    const dif = x.u.valor - ultimo("ES", t.startsWith("Gasolina") ? "euro95" : "diesel")!.valor;
                    return (
                      <tr class={x.cc === "ES" ? "mejor" : undefined}>
                        <td>{i + 1}. <a href={url(x.cc)}>{nombrePais(x.cc, "es")}</a></td>
                        <td class="num">{eur(x.u.valor)}</td>
                        <td class={`num ${dif > 0 ? "sube" : dif < 0 ? "baja" : ""}`}>{x.cc === "ES" ? "—" : `${dif > 0 ? "+" : ""}${(dif * 100).toLocaleString("es-ES", { maximumFractionDigits: 0 })} cts`}</td>
                      </tr>
                    );
                  })}
                </tbody>
              </table>
            </div>
          </div>
        ))
      }
    </div>
    <p class="wrap caption" style="margin-top:8px">Precios medios con impuestos. Fuente: <a href={FUENTE_UE.url} rel="noopener">Comisión Europea, Boletín Petrolero semanal</a>. Los países fuera de la UE (Andorra, Suiza, Noruega, Reino Unido) no aparecen.</p>
  </section>
  <Anuncio tipo="horizontal" seccion />
  <section class="section section--white">
    <div class="wrap wrap--narrow">
      <h2 style="font-size:24px;margin-bottom:12px">Preguntas frecuentes</h2>
      {preguntas.map((q) => (
        <details class="faq-c">
          <summary>{q.p}</summary>
          <p>{q.r}</p>
        </details>
      ))}
      <p class="small" style="margin-top:16px">Para repostar en España: <a href="/gasolineras-baratas/">gasolineras baratas por provincia</a> · <a href="/precio-gasolina-hoy/">precio de la gasolina hoy</a> · <a href="/precio-gasoil-hoy/">precio del gasoil hoy</a>.</p>
    </div>
  </section>
</Base>

<style>
  .faq-c {
    border-bottom: 1px solid var(--color-pale-sage);
    padding: 6px 0;
  }
  .faq-c summary {
    color: var(--color-bark);
  }
  .faq-c p {
    padding: 4px 0 12px 20px;
  }
</style>
