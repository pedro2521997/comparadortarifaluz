---
// Logotipo: símbolo (la «C» con el punto menta, mismo dibujo que scripts/iconos.mjs) y el nombre.
// En fondo oscuro (pie) el cuadro va en menta y la «C» en verde para que no se pierda contra el fondo.
interface Props {
  blanco?: boolean;
}
const { blanco = false } = Astro.props;
---

<span class:list={["logo", { "logo--blanco": blanco }]}>
  <svg class="logo__s" width="30" height="30" viewBox="0 0 48 48" aria-hidden="true">
    <rect width="48" height="48" rx="12" fill={blanco ? "#0fff87" : "#104336"}></rect>
    <path d="M31.71 14.81A12 12 0 1 0 31.71 33.19" fill="none" stroke={blanco ? "#104336" : "#ffffff"} stroke-width="7"></path>
    <circle cx="32" cy="24" r="4.5" fill={blanco ? "#ffffff" : "#0fff87"}></circle>
  </svg>
  <span class="logo__t">Comparador<strong>TarifaLuz</strong><span class="logo__es">.es</span></span>
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: 20px;
    font-weight: 500;
    letter-spacing: -0.02em;
    color: var(--color-canopy);
  }
  .logo__s {
    flex: none;
  }
  .logo__es {
    font-size: 0.75em;
    font-weight: 400;
    letter-spacing: 0;
    color: var(--color-slate);
    margin-left: 1px;
  }
  .logo--blanco .logo__es {
    color: rgba(255, 255, 255, 0.7);
  }
  @media (max-width: 380px) {
    .logo {
      font-size: 17px;
    }
  }
  .logo strong {
    font-weight: 700;
  }
  .logo--blanco {
    color: #fff;
  }
</style>
