---
// Precio del gasóleo de calefacción (gasóleo C) en España: dato semanal de la Comisión Europea, evolución,
// coste de un pedido de 1.000 litros y comparación con otros sistemas de calefacción.
import Base from "../layouts/Base.astro";
import Anuncio from "../components/Anuncio.astro";
import { esquemaFaq } from "../lib/faq";
import { fechaMedia } from "../lib/formato";
import { graficaLineas } from "../lib/compartido/grafica-svg";
import { ultimo, ultimas, nombrePais, FUENTE_UE } from "../lib/compartido/carburantes-ue";

const u = ultimo("ES", "calefaccion")!;
const ue = ultimo("EU", "calefaccion");
const eur = (n: number) => `${n.toLocaleString("es-ES", { minimumFractionDigits: 3, maximumFractionDigits: 3 })} €/l`;
const e2 = (n: number) => `${n.toLocaleString("es-ES", { maximumFractionDigits: 0 })} €`;
const semana = fechaMedia(u.semana);
const s = ultimas("ES", "calefaccion", 156);
const sUE = ultimas("EU", "calefaccion", 156);
const mesCorto = (f: string) => new Date(`${f}T12:00:00Z`).toLocaleDateString("es-ES", { month: "short", year: "numeric" });
// Mes más barato de media en los últimos tres años (para el consejo de cuándo comprar).
const porMes = new Map<number, number[]>();
s.fechas.forEach((f, i) => s.valores[i] != null && porMes.set(Number(f.slice(5, 7)), [...(porMes.get(Number(f.slice(5, 7))) ?? []), s.valores[i]!]));
const medias = [...porMes.entries()].map(([m, v]) => ({ m, media: v.reduce((a, b) => a + b, 0) / v.length })).sort((a, b) => a.media - b.media);
const nombreMes = (m: number) => new Date(Date.UTC(2026, m - 1, 15)).toLocaleDateString("es-ES", { month: "long" });
const kwh = u.valor / 10 / 0.9; // ~10 kWh por litro y caldera del 90 %
const preguntas = [
  { p: "¿Cuánto cuesta el gasóleo de calefacción hoy?", r: `En la semana del ${semana}, el gasóleo C cuesta de media ${eur(u.valor)} en España con impuestos (Boletín Petrolero de la Comisión Europea). Un pedido de 1.000 litros sale por unos ${e2(u.valor * 1000)}; el precio final depende del distribuidor y de la cantidad.` },
  { p: "¿Cuándo es más barato comprar gasóleo de calefacción?", r: `En los últimos tres años, el mes más barato de media ha sido ${nombreMes(medias[0].m)} y el más caro ${nombreMes(medias.at(-1)!.m)}. Llenar el depósito fuera de temporada (primavera o verano) y pedir cantidades grandes suele salir más barato por litro.` },
  { p: "¿Sale más caro que el gas o la aerotermia?", r: `Con el precio actual, el calor útil del gasóleo cuesta unos ${(kwh * 100).toLocaleString("es-ES", { maximumFractionDigits: 1 })} céntimos por kWh. Una aerotermia suele salir a la mitad o menos. Compáralo con tus datos en la calculadora de calefacción.` },
];
---

<Base
  titulo={`Precio del gasóleo de calefacción hoy: ${eur(u.valor)} (${semana.replace(/ de \d{4}$/, "")})`}
  descripcion={`Gasóleo C a ${eur(u.valor)} de media en España (semana del ${semana}). Cuánto cuestan 1.000 litros, evolución y el mejor momento para llenar el depósito.`.slice(0, 160)}
  schema={esquemaFaq(preguntas)}
  migas={[["Gasolineras baratas", "/gasolineras-baratas/"], ["Gasóleo de calefacción"]]}
>
  <section class="hero hero--compacto">
    <div class="wrap">
      <span class="eyebrow">Semana del {semana}</span>
      <h1>Precio del gasóleo de calefacción</h1>
      <p class="lead">El gasóleo C cuesta <strong>{eur(u.valor)}</strong> de media en España{ue && `, frente a ${eur(ue.valor)} en la ${nombrePais("EU", "es")}`}. Llenar un depósito de 1.000 litros sale por unos <strong>{e2(u.valor * 1000)}</strong>.</p>
    </div>
  </section>
  <section class="section section--tight">
    <div class="wrap stack" style="--stack:32px">
      <div class="grid grid--4 stats">
        <div class="stat"><span class="stat__label">Precio medio</span><span class="stat__value">{eur(u.valor).replace(" €/l", "")}<small> €/l</small></span><span class="stat__sub">{u.anterior && `semana anterior ${eur(u.anterior)}`}</span></div>
        <div class="stat"><span class="stat__label">500 litros</span><span class="stat__value">{e2(u.valor * 500)}</span><span class="stat__sub">aprox.</span></div>
        <div class="stat"><span class="stat__label">1.000 litros</span><span class="stat__value">{e2(u.valor * 1000)}</span><span class="stat__sub">aprox.</span></div>
        <div class="stat"><span class="stat__label">Hace un año</span><span class="stat__value">{u.haceUnAno ? eur(u.haceUnAno).replace(" €/l", "") : "—"}<small> €/l</small></span><span class="stat__sub">{u.haceUnAno && `${u.valor > u.haceUnAno ? "ahora más caro" : "ahora más barato"}`}</span></div>
      </div>
      <div>
        <h2 style="font-size:22px;margin-bottom:12px">Evolución en los últimos tres años</h2>
        <Fragment set:html={graficaLineas([{ nombre: "España", valores: s.valores }, { nombre: nombrePais("EU", "es"), valores: sUE.valores }], { etiquetas: s.fechas.map(mesCorto), formato: (n) => n.toFixed(2).replace(".", ","), resumen: "Precio semanal del gasóleo de calefacción en España y la UE" })} />
        <p class="caption">€/litro con impuestos, media nacional. Fuente: <a href={FUENTE_UE.url} rel="noopener">Comisión Europea, Boletín Petrolero semanal</a>.</p>
      </div>
    </div>
  </section>
  <Anuncio tipo="horizontal" seccion />
  <section class="section section--white">
    <div class="wrap wrap--narrow prose">
      <h2>Cómo pagar menos por el gasóleo de calefacción</h2>
      <ul>
        <li><strong>Compra fuera de temporada.</strong> En otoño e invierno sube la demanda; en los últimos tres años {nombreMes(medias[0].m)} ha sido el mes más barato de media.</li>
        <li><strong>Pide más litros de una vez</strong> o júntate con vecinos: muchos distribuidores bajan el precio por litro a partir de 1.000–2.000 litros.</li>
        <li><strong>Pide dos o tres presupuestos</strong> el mismo día: entre distribuidores de una misma zona hay diferencias de varios céntimos.</li>
        <li><strong>Revisa la caldera cada año</strong>: una caldera sucia o mal regulada gasta un 5–10 % más.</li>
        <li><strong>Baja un grado el termostato</strong>: cada grado menos ahorra en torno a un 7 % de combustible.</li>
      </ul>
      <p>¿Te compensa cambiar de sistema? Compara gasóleo, gas, pellets, aerotermia y radiadores eléctricos con la <a href="/herramientas/calefaccion/">calculadora de calefacción</a>.</p>
      <h2>Preguntas frecuentes</h2>
    </div>
    <div class="wrap wrap--narrow">
      {preguntas.map((q) => (
        <details class="faq-c">
          <summary>{q.p}</summary>
          <p>{q.r}</p>
        </details>
      ))}
    </div>
  </section>
</Base>

<style>
  .faq-c {
    border-bottom: 1px solid var(--color-pale-sage);
    padding: 6px 0;
  }
  .faq-c summary {
    color: var(--color-bark);
  }
  .faq-c p {
    padding: 4px 0 12px 20px;
  }
</style>
