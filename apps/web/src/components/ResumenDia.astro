---
// Bajo el gráfico de un día: precio por tramos del día y preguntas frecuentes con el dato de ese día.
// Texto propio de cada fecha (lo que Google necesita para posicionar «precio luz 26 octubre 2026»).
// En «hoy» y «mañana» se oculta en el navegador si la página es de un build de otro día (data-dia-fijo).
import type { InfoDia } from "../lib/dia";
import { preguntasDia } from "../lib/dia";
import { ekwh, hh } from "../lib/formato";

interface Props {
  i: InfoDia;
}
const { i } = Astro.props;
const conMedia = i.tramos.filter((t) => t.media !== null);
const masBarato = conMedia.reduce((a, t) => (t.media! < a.media! ? t : a), conMedia[0]);
const preguntas = preguntasDia(i);
---

<section class="section section--white section--tight" data-dia-fijo={i.fecha}>
  <div class="wrap grid grid--2" style="gap:40px">
    <div>
      <h2 class="rd-h">El precio por tramos, {i.fechaM}</h2>
      <table class="rd-tabla">
        <thead><tr><th scope="col">Tramo</th><th scope="col">Horas</th><th scope="col" class="num">Media</th></tr></thead>
        <tbody>
          {
            conMedia.map((t) => (
              <tr class={t === masBarato ? "rd-mejor" : undefined}>
                <th scope="row">{t.nombre}{t === masBarato && <span class="pill pill--barata">el más barato</span>}</th>
                <td>{hh(t.desde)}–{hh(t.hasta)}</td>
                <td class="num">{ekwh(t.media!)}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
      <p class="caption" style="margin-top:8px">PVPC 2.0TD sin impuestos. {i.vsSemana && <>Este día sale {i.vsSemana}.</>}</p>
    </div>
    <div>
      <h2 class="rd-h">Preguntas sobre el precio de este día</h2>
      {
        preguntas.map((p) => (
          <details class="faq">
            <summary>{p.p}</summary>
            <p>{p.r}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .rd-h {
    font-size: 22px;
    margin-bottom: 12px;
  }
  .rd-tabla {
    width: 100%;
    border-collapse: collapse;
    font-size: 15px;
  }
  .rd-tabla th,
  .rd-tabla td {
    text-align: left;
    padding: 8px 6px;
    border-bottom: 1px solid var(--color-pale-sage);
  }
  .rd-tabla .num {
    text-align: right;
    font-variant-numeric: tabular-nums;
  }
  .rd-tabla tbody th {
    font-weight: 500;
  }
  .rd-tabla .pill {
    margin-left: 8px;
  }
  .rd-mejor {
    background: #f2faf6;
  }
  .faq {
    border-bottom: 1px solid var(--color-pale-sage);
    padding: 6px 0;
  }
  .faq summary {
    color: var(--color-bark);
    cursor: pointer;
  }
  .faq p {
    padding: 4px 0 12px 20px;
  }
</style>
