---
import Base from "../layouts/Base.astro";
import { tarifas, regulados, festivos } from "../lib/datos";
import { hoyMadrid } from "../lib/formato";

const datos = { tarifas, regulados, festivos, hoy: hoyMadrid() };
const opcionesTarifa = tarifas.filter((t) => t.id !== "pvpc");
---

<Base
  titulo="Comparador de tarifas de luz con tu fichero de consumo"
  descripcion="Sube el fichero de consumos de tu distribuidora o de Datadis y descubre cuánto habrías pagado con cada tarifa. Se calcula en tu navegador: el fichero no sale de tu ordenador."
>
  <section class="hero hero--compacto">
    <div class="wrap">
      <span class="eyebrow">Comparador con tu fichero</span>
      <h1>¿Tu tarifa es buena? Compruébalo con tu consumo real</h1>
      <p class="lead">
        Sube el fichero de consumos hora a hora de tu distribuidora y calculamos cuánto habrías pagado con cada tarifa en ese mismo periodo.
      </p>
      <p class="privacidad">
        <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 2 4 5v6c0 5 3.4 9.7 8 11 4.6-1.3 8-6 8-11V5l-8-3zm-1 14-4-4 1.4-1.4L11 13.2l4.6-4.6L17 10l-6 6z"></path></svg>
        <span><strong>Tu fichero se procesa en tu navegador y nunca sale de tu ordenador.</strong> No lo subimos a ningún servidor.</span>
      </p>
    </div>
  </section>

  <section class="section section--tight">
    <div class="wrap comparador">
      <ol class="pasos">
        <li class="paso">
          <h2 class="paso__t">Descarga tu fichero de consumos</h2>
          <p class="muted">
            Entra en <a href="https://datadis.es" rel="noopener">Datadis</a> (la plataforma común de todas las distribuidoras) o en la web de tu distribuidora y descarga el consumo horario en CSV. Cuanto más largo el periodo, mejor: lo ideal es un año.
          </p>
          <p><a href="/guias/descargar-consumo-datadis/">Cómo descargarlo paso a paso</a></p>
        </li>

        <li class="paso">
          <h2 class="paso__t">Súbelo aquí</h2>
          <label class="dropzone" for="fichero" id="dropzone">
            <input id="fichero" type="file" accept=".csv,.txt,text/csv,text/plain" class="sr-only" />
            <span class="dropzone__icono" aria-hidden="true">
              <svg width="32" height="32" viewBox="0 0 24 24"><path fill="currentColor" d="M19 15v4H5v-4H3v4a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-4h-2zM11 4.8V16h2V4.8l3.6 3.6L18 7l-6-6-6 6 1.4 1.4L11 4.8z"></path></svg>
            </span>
            <span class="dropzone__t">Elige el fichero CSV o arrástralo aquí</span>
            <span class="caption">Datadis, i-DE, e-distribución, UFD y otras distribuidoras</span>
          </label>
          <p class="btn-row" style="margin-top:12px">
            <button class="btn btn--ghost btn--small" type="button" id="ejemplo">Probar con un fichero de ejemplo</button>
          </p>
          <div id="estado-fichero" aria-live="polite"></div>
          <div id="mapeo" hidden></div>
        </li>

        <li class="paso">
          <h2 class="paso__t">Tu potencia y tu tarifa actual</h2>
          <form id="form-datos" class="stack" style="--stack:20px">
            <div class="form-grid form-grid--2">
              <div class="field">
                <label for="p1">Potencia contratada en punta (P1)</label>
                <input id="p1" type="number" inputmode="decimal" min="0.5" max="15" step="0.01" value="3.45" required />
                <span class="hint">En kW. Está en tu factura, en «potencia contratada».</span>
              </div>
              <div class="field">
                <label for="p2">Potencia contratada en valle (P2)</label>
                <input id="p2" type="number" inputmode="decimal" min="0.5" max="15" step="0.01" value="3.45" required />
                <span class="hint">Si solo ves una cifra, pon la misma.</span>
              </div>
            </div>
            <div class="field">
              <label for="actual">Tu tarifa actual</label>
              <select id="actual">
                <option value="">No lo sé: comparar solo entre tarifas</option>
                <option value="pvpc">PVPC (tarifa regulada)</option>
                {opcionesTarifa.map((t) => <option value={t.id}>{t.comercializadora} · {t.nombre}</option>)}
                <option value="otra">Otra: escribir sus precios</option>
              </select>
            </div>
            <fieldset id="otra" class="otra" hidden>
              <legend>Precios de tu tarifa, sin impuestos (están en tu factura o tu contrato)</legend>
              <div class="form-grid form-grid--3">
                <div class="field"><label for="o-e1">Energía punta €/kWh</label><input id="o-e1" type="number" step="0.0001" min="0" inputmode="decimal" placeholder="0,1500" /></div>
                <div class="field"><label for="o-e2">Energía llano €/kWh</label><input id="o-e2" type="number" step="0.0001" min="0" inputmode="decimal" placeholder="Igual si es precio único" /></div>
                <div class="field"><label for="o-e3">Energía valle €/kWh</label><input id="o-e3" type="number" step="0.0001" min="0" inputmode="decimal" placeholder="Igual si es precio único" /></div>
                <div class="field"><label for="o-p1">Potencia P1 €/kW·día</label><input id="o-p1" type="number" step="0.0001" min="0" inputmode="decimal" placeholder="0,0890" /></div>
                <div class="field"><label for="o-p2">Potencia P2 €/kW·día</label><input id="o-p2" type="number" step="0.0001" min="0" inputmode="decimal" placeholder="0,0089" /></div>
                <div class="field"><label for="o-cuota">Cuota fija €/mes</label><input id="o-cuota" type="number" step="0.01" min="0" inputmode="decimal" value="0" /></div>
              </div>
            </fieldset>
            <div>
              <button class="btn btn--mint" type="submit" id="calcular" disabled>Calcular cuánto habría pagado</button>
              <p class="caption" style="margin-top:8px" id="calcular-ayuda">Primero sube tu fichero o prueba con el de ejemplo.</p>
            </div>
          </form>
        </li>
      </ol>

      <div id="resultado" class="resultado" hidden tabindex="-1" aria-live="polite"></div>
    </div>
  </section>

  <script type="application/json" id="datos-comparador" set:html={JSON.stringify(datos)} />
</Base>

<script>
  import "../scripts/comparador";
</script>

<style is:global>
  .privacidad {
    display: flex;
    gap: 10px;
    align-items: flex-start;
    margin-top: 24px;
    padding: 12px 16px;
    background: var(--color-sheet-white);
    border: 1px solid var(--color-sage-mist);
    border-radius: var(--radius-buttons);
    max-width: 62ch;
    font-size: 15px;
    color: var(--color-canopy);
  }
  .privacidad svg {
    flex: none;
    margin-top: 1px;
  }
  .paso__t {
    font-size: var(--text-heading-sm);
    font-weight: var(--font-weight-medium);
    color: var(--color-bark);
    margin-bottom: 12px;
    line-height: 1.3;
  }
  .paso > p + p {
    margin-top: 8px;
  }
  .comparador .pasos {
    max-width: 800px;
    gap: 48px;
  }
  .dropzone {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    padding: 32px 16px;
    border: 2px dashed var(--color-sage-mist);
    border-radius: var(--radius-cards);
    background: var(--color-sheet-white);
    text-align: center;
    cursor: pointer;
    transition: border-color 0.15s, background-color 0.15s;
  }
  .dropzone:hover,
  .dropzone.is-over,
  .dropzone:focus-within {
    border-color: var(--color-canopy);
    background: #f7fbf9;
  }
  .dropzone:focus-within {
    outline: 3px solid var(--color-orb-violet);
    outline-offset: 2px;
  }
  .dropzone__icono {
    color: var(--color-canopy);
  }
  .dropzone__t {
    font-weight: var(--font-weight-medium);
    color: var(--color-canopy);
  }
  #estado-fichero:not(:empty) {
    margin-top: 16px;
  }
  .otra {
    border: 1px solid var(--color-sage-mist);
    border-radius: var(--radius-cards);
    padding: 16px 20px 20px;
    margin: 0;
    background: var(--color-sheet-white);
  }
  .otra legend {
    font-weight: var(--font-weight-medium);
    padding: 0 6px;
    font-size: 15px;
  }
  .resultado {
    margin-top: 64px;
    scroll-margin-top: 88px;
  }
  .resultado:focus {
    outline: none;
  }
  .res-cab {
    background: var(--color-sheet-white);
    border: 1px solid var(--color-sage-mist);
    border-radius: var(--radius-cards);
    padding: 32px 24px;
  }
  @media (min-width: 768px) {
    .res-cab {
      padding: 48px;
    }
  }
  .res-cab .answer {
    margin: 12px 0 16px;
  }
  .ranking {
    list-style: none;
    margin: 24px 0 0;
    padding: 0;
    display: grid;
    gap: 12px;
  }
  .tar {
    background: var(--color-sheet-white);
    border: 1px solid var(--color-sage-mist);
    border-radius: var(--radius-cards);
    padding: 20px;
  }
  .tar--actual {
    border-color: var(--color-canopy);
    box-shadow: inset 4px 0 0 var(--color-canopy);
  }
  .tar__top {
    display: grid;
    grid-template-columns: 32px minmax(0, 1fr) auto;
    gap: 12px;
    align-items: start;
  }
  .tar__pos {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: var(--color-cream-paper);
    border: 1px solid var(--color-sage-mist);
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: var(--font-weight-medium);
    font-size: 14px;
  }
  .tar:first-child .tar__pos {
    background: var(--color-mint-pulse);
    border-color: var(--color-mint-pulse);
  }
  .tar__nombre {
    font-weight: var(--font-weight-medium);
    font-size: 18px;
    line-height: 1.3;
  }
  .tar__com {
    font-size: 14px;
    color: var(--color-slate);
  }
  .tar__badges {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 8px;
  }
  .tar__total {
    text-align: right;
  }
  .tar__total strong {
    display: block;
    font-size: 24px;
    font-weight: var(--font-weight-medium);
    font-variant-numeric: tabular-nums;
  }
  .tar__total span {
    font-size: 13px;
    color: var(--color-slate);
    white-space: nowrap;
  }
  .tar__dif {
    font-size: 14px;
    font-weight: var(--font-weight-medium);
  }
  .tar__dif--mas {
    color: var(--color-orb-violet);
  }
  .tar__dif--menos {
    color: var(--color-canopy);
  }
  .tar details {
    margin-top: 12px;
    border-top: 1px solid var(--color-pale-sage);
    padding-top: 4px;
  }
  .tar__detalle {
    display: grid;
    gap: 16px;
    padding: 8px 0 4px;
  }
  @media (min-width: 720px) {
    .tar__detalle {
      grid-template-columns: 1fr 1fr;
    }
  }
  .desglose {
    width: 100%;
    font-size: 14px;
  }
  .desglose td {
    padding: 4px 0;
    border: 0;
  }
  .desglose tr.total td {
    border-top: 1px solid var(--color-pale-sage);
    font-weight: var(--font-weight-medium);
    padding-top: 8px;
  }
  .extras {
    margin-top: 48px;
  }
  .extras h3 {
    margin-bottom: 8px;
  }
  .solar-cta {
    display: flex;
    flex-direction: column;
    gap: 24px;
    align-items: flex-start;
  }
  @media (min-width: 900px) {
    .solar-cta {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
  }
  .extras .answer {
    margin: 0;
  }
  .mapeo-grid {
    display: grid;
    gap: 12px;
    margin-top: 12px;
  }
  @media (min-width: 640px) {
    .mapeo-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
</style>
