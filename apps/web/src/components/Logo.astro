---
interface Props {
  blanco?: boolean;
}
const { blanco = false } = Astro.props;
---

<span class:list={["logo", { "logo--blanco": blanco }]}>
  <svg width="28" height="28" viewBox="0 0 32 32" aria-hidden="true">
    <circle cx="16" cy="16" r="16" fill={blanco ? "#ffffff" : "#104336"}></circle>
    <path d="M18 5 9 18h6l-2 9 10-14h-6l1-8z" fill="#0fff87"></path>
  </svg>
  <span>Luz<strong>SinTrampa</strong></span>
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: 20px;
    font-weight: 400;
    letter-spacing: -0.01em;
    color: var(--color-canopy);
  }
  .logo strong {
    font-weight: 500;
  }
  .logo--blanco {
    color: #fff;
  }
</style>
