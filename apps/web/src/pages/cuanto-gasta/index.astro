---
import Base from "../../layouts/Base.astro";
import Anuncio from "../../components/Anuncio.astro";
import CalculadoraAparato from "../../components/CalculadoraAparato.astro";
import Tarjeta from "../../components/Tarjeta.astro";
import { aparatos, dias, factorImpuestos, kwhMesAparato } from "../../lib/datos";
import { resumen } from "../../lib/grafico";
import { ICONO_APARATO } from "../../lib/iconos";
import { eur2, fechaCorta, hoyMadrid, kwh } from "../../lib/formato";

const hoy = hoyMadrid();
const dia = [...dias].reverse().find((d) => d.fecha <= hoy)!;
const precioHoy = resumen(dia.precios).media * factorImpuestos(hoy);
const TONOS = ["menta", "salvia", "lavanda"] as const;

const grupos = [...new Set(aparatos.map((a) => a.grupo))].map((g) => ({ nombre: g, lista: aparatos.filter((a) => a.grupo === g) }));
---

<Base
  titulo="Cuánto gasta cada aparato en luz, con el precio de hoy"
  descripcion="Calcula cuánto te cuesta al mes el aire acondicionado, la lavadora, el horno o cargar el coche con el precio de la luz de hoy, y a qué hora te sale más barato."
>
  <section class="hero hero--compacto">
    <div class="wrap">
      <span class="eyebrow">Cuánto gasta</span>
      <h1>¿Cuánto te cuesta encender eso?</h1>
      <p class="lead">Pon la potencia o el consumo de la etiqueta y cuántas horas lo usas. Te decimos lo que cuesta con el precio de la luz de hoy y a qué hora sale más barato.</p>
    </div>
  </section>
  <section class="section section--tight">
    <div class="wrap">
      <CalculadoraAparato />
    </div>
  </section>
  <Anuncio tipo="horizontal" seccion />
  <section class="section section--white">
    <div class="wrap stack" style="--stack:40px">
      <div>
        <span class="eyebrow">Aparato por aparato</span>
        <h2 style="margin-top:12px">Valores típicos ya cargados</h2>
        <p class="muted" style="margin-top:8px">Pulsa una tarjeta para darle la vuelta y ver lo que cuesta al mes con el precio de hoy.</p>
      </div>
      {
        grupos.map((g) => (
          <div>
            <h3 class="grupo">{g.nombre}</h3>
            <ul class="flip-rejilla">
              {g.lista.map((a, k) => (
                <li>
                  <Tarjeta etiqueta={a.nombre} tono={TONOS[k % 3]}>
                    <Fragment slot="frente">
                      <span class="flip__img" aria-hidden="true">{ICONO_APARATO[a.slug] ?? "🔌"}</span>
                      <span class="flip__t">{a.nombre}</span>
                      <span class="flip__dato">≈ {kwh(kwhMesAparato(a))} al mes</span>
                    </Fragment>
                    <Fragment slot="dorso">
                      <span class="flip__dato">Con el precio del {fechaCorta(dia.fecha)}</span>
                      <span class="flip__grande">{eur2(kwhMesAparato(a) * precioHoy)}<small> /mes</small></span>
                      <span class="ap-truco">{a.truco.split(". ")[0].replace(/\.$/, "")}.</span>
                      <a href={`/cuanto-gasta/${a.slug}/`}>Calcular mi caso →</a>
                    </Fragment>
                  </Tarjeta>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </section>
</Base>

<style>
  .grupo {
    margin-bottom: 16px;
  }
  .ap-truco {
    font-size: 14px;
    line-height: 1.4;
  }
</style>
