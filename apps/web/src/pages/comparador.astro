---
import Base from "../layouts/Base.astro";
import { tarifas, regulados, festivos, dias } from "../lib/datos";
import { hoyMadrid } from "../lib/formato";
import { marca, nombrePlan } from "../lib/ranking";
import { PERFILES } from "@lst/tarifa";

const hoy = hoyMadrid();
const ultimoPvpc = [...dias].reverse().find((d) => d.fecha <= hoy)?.fecha ?? hoy;
const datos = { tarifas, regulados, festivos, hoy, ultimoPvpc };
// Tarifa actual: agrupadas por comercializadora para encontrarla rápido.
const grupos = new Map<string, typeof tarifas>();
for (const t of tarifas.filter((x) => x.tipo !== "pvpc")) {
  const m = marca(t.comercializadora);
  grupos.set(m, [...(grupos.get(m) ?? []), t]);
}
const gruposOrdenados = [...grupos.entries()].sort((a, b) => a[0].localeCompare(b[0], "es"));
---

<Base
  titulo={`Comparador de tarifas de luz ${hoy.slice(0, 4)}: ${tarifas.length} tarifas con tu consumo`}
  descripcion={`Compara ${tarifas.length} tarifas de luz de ${grupos.size} comercializadoras con tu fichero de consumos o con los datos de tu factura. Ranking por precio, sin comisiones que alteren el orden.`}
>
  <section class="hero hero--compacto">
    <div class="wrap">
      <span class="eyebrow">Comparador de tarifas</span>
      <h1>¿Tu tarifa es buena? Compruébalo con tu consumo real</h1>
      <p class="lead">
        Calculamos cuánto habrías pagado con cada una de las {tarifas.length} tarifas de {grupos.size + 1} comercializadoras, hora a hora, y te damos el ranking completo.
      </p>
      <p class="privacidad">
        <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 2 4 5v6c0 5 3.4 9.7 8 11 4.6-1.3 8-6 8-11V5l-8-3zm-1 14-4-4 1.4-1.4L11 13.2l4.6-4.6L17 10l-6 6z"></path></svg>
        <span><strong>Tu fichero se procesa en tu navegador y nunca sale de tu ordenador.</strong> No lo subimos a ningún servidor.</span>
      </p>
    </div>
  </section>

  <section class="section section--tight">
    <div class="wrap comparador">
      <ol class="pasos">
        <li class="paso">
          <h2 class="paso__t">Tu consumo</h2>
          <div class="modos" role="tablist" aria-label="Cómo quieres dar tu consumo">
            <button type="button" role="tab" class="modo" data-modo="fichero" aria-selected="true" aria-controls="panel-fichero">
              <strong>Con mi fichero</strong><span>Hora a hora. Lo más preciso.</span>
            </button>
            <button type="button" role="tab" class="modo" data-modo="factura" aria-selected="false" aria-controls="panel-factura">
              <strong>Con mi factura</strong><span>Consumo anual o por periodos.</span>
            </button>
          </div>

          <div id="panel-fichero" role="tabpanel" class="stack" style="--stack:12px">
            <p class="muted">
              Descárgalo en <a href="https://datadis.es" rel="noopener">Datadis</a> o en la web de tu distribuidora (consumo horario en CSV; lo ideal es un año). <a href="/guias/descargar-consumo-datadis/">Cómo descargarlo</a>
            </p>
            <label class="dropzone" for="fichero" id="dropzone">
              <input id="fichero" type="file" accept=".csv,.txt,text/csv,text/plain" class="sr-only" />
              <span class="dropzone__icono" aria-hidden="true">
                <svg width="32" height="32" viewBox="0 0 24 24"><path fill="currentColor" d="M19 15v4H5v-4H3v4a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-4h-2zM11 4.8V16h2V4.8l3.6 3.6L18 7l-6-6-6 6 1.4 1.4L11 4.8z"></path></svg>
              </span>
              <span class="dropzone__t">Elige el fichero CSV o arrástralo aquí</span>
              <span class="caption">Datadis, i-DE, e-distribución, UFD y otras distribuidoras</span>
            </label>
            <p class="btn-row">
              <button class="btn btn--ghost btn--small" type="button" id="ejemplo">Probar con un fichero de ejemplo</button>
            </p>
            <div id="estado-fichero" aria-live="polite"></div>
            <div id="mapeo" hidden></div>
          </div>

          <div id="panel-factura" role="tabpanel" class="stack" style="--stack:16px" hidden>
            <fieldset class="seg-f">
              <legend class="label">¿Qué dato tienes?</legend>
              <label class="check"><input type="radio" name="fact-dato" value="anual" checked /> <span>Consumo anual (kWh)</span></label>
              <label class="check"><input type="radio" name="fact-dato" value="periodos" /> <span>kWh de punta, llano y valle de una factura</span></label>
            </fieldset>
            <div id="fact-anual" class="form-grid form-grid--2">
              <div class="field">
                <label for="fa-kwh">Consumo al año</label>
                <input id="fa-kwh" type="number" inputmode="numeric" min="100" max="100000" step="50" value="3000" />
                <span class="hint">kWh. Suele venir en la factura («consumo del último año»). Un hogar medio gasta 2.500–3.500 kWh.</span>
              </div>
            </div>
            <div id="fact-periodos" class="form-grid form-grid--2" hidden>
              <div class="field"><label for="fp-p1">kWh en punta (P1)</label><input id="fp-p1" type="number" inputmode="numeric" min="0" step="1" value="70" /></div>
              <div class="field"><label for="fp-p2">kWh en llano (P2)</label><input id="fp-p2" type="number" inputmode="numeric" min="0" step="1" value="65" /></div>
              <div class="field"><label for="fp-p3">kWh en valle (P3)</label><input id="fp-p3" type="number" inputmode="numeric" min="0" step="1" value="115" /></div>
              <div class="field"><label for="fp-dias">Días de la factura</label><input id="fp-dias" type="number" inputmode="numeric" min="7" max="400" step="1" value="30" /></div>
            </div>
            <div class="field" style="max-width:420px">
              <label for="perfil">Cómo se reparte tu consumo</label>
              <select id="perfil" aria-describedby="perfil-ayuda">
                {Object.entries(PERFILES).map(([k, p]) => <option value={k}>{p.nombre}</option>)}
              </select>
              <ul class="hint perfiles-ayuda" id="perfil-ayuda">
                {Object.values(PERFILES).map((p) => <li><strong>{p.nombre}:</strong> {p.descripcion}</li>)}
              </ul>
            </div>
          </div>
        </li>

        <li class="paso">
          <h2 class="paso__t">Tu potencia y tu tarifa actual</h2>
          <form id="form-datos" class="stack" style="--stack:20px">
            <div class="form-grid form-grid--2">
              <div class="field">
                <label for="p1">Potencia contratada en punta (P1)</label>
                <input id="p1" type="number" inputmode="decimal" min="0.5" max="15" step="0.01" value="3.45" required />
                <span class="hint">En kW. Está en tu factura, en «potencia contratada».</span>
              </div>
              <div class="field">
                <label for="p2">Potencia contratada en valle (P2)</label>
                <input id="p2" type="number" inputmode="decimal" min="0.5" max="15" step="0.01" value="3.45" required />
                <span class="hint">Si solo ves una cifra, pon la misma.</span>
              </div>
            </div>
            <div class="field">
              <label for="actual">Tu tarifa actual</label>
              <select id="actual">
                <option value="">No lo sé: comparar solo entre tarifas</option>
                <option value="pvpc">PVPC (tarifa regulada)</option>
                {
                  gruposOrdenados.map(([m, lista]) => (
                    <optgroup label={m}>
                      {lista.map((t) => <option value={t.id}>{m} · {nombrePlan(t.nombre)}</option>)}
                    </optgroup>
                  ))
                }
                <option value="otra">Otra: escribir sus precios</option>
              </select>
            </div>
            <fieldset id="otra" class="otra" hidden>
              <legend>Precios de tu tarifa, sin impuestos (están en tu factura o tu contrato)</legend>
              <div class="form-grid form-grid--3">
                <div class="field"><label for="o-e1">Energía punta €/kWh</label><input id="o-e1" type="number" step="0.0001" min="0" inputmode="decimal" placeholder="0,1500" /></div>
                <div class="field"><label for="o-e2">Energía llano €/kWh</label><input id="o-e2" type="number" step="0.0001" min="0" inputmode="decimal" placeholder="Igual si es precio único" /></div>
                <div class="field"><label for="o-e3">Energía valle €/kWh</label><input id="o-e3" type="number" step="0.0001" min="0" inputmode="decimal" placeholder="Igual si es precio único" /></div>
                <div class="field"><label for="o-p1">Potencia P1 €/kW·día</label><input id="o-p1" type="number" step="0.0001" min="0" inputmode="decimal" placeholder="0,0890" /></div>
                <div class="field"><label for="o-p2">Potencia P2 €/kW·día</label><input id="o-p2" type="number" step="0.0001" min="0" inputmode="decimal" placeholder="0,0089" /></div>
                <div class="field"><label for="o-cuota">Cuota fija €/mes</label><input id="o-cuota" type="number" step="0.01" min="0" inputmode="decimal" value="0" /></div>
              </div>
            </fieldset>
            <details class="avanzado">
              <summary>Opciones avanzadas</summary>
              <div class="form-grid form-grid--2" style="padding-top:12px">
                <div class="field">
                  <label for="analisis">Periodo del fichero a analizar</label>
                  <select id="analisis">
                    <option value="0">Todo el fichero</option>
                    <option value="12">Últimos 12 meses</option>
                    <option value="6">Últimos 6 meses</option>
                    <option value="3">Últimos 3 meses</option>
                    <option value="1">Último mes</option>
                  </select>
                </div>
                <div class="field">
                  <label for="habitos">Cambio de hábitos: <strong id="habitos-v">sin cambios</strong></label>
                  <input id="habitos" type="range" min="-50" max="50" step="5" value="0" />
                  <span class="hint">Simula que consumes más (un coche, una bomba de calor) o menos.</span>
                </div>
                <div class="field">
                  <label for="zona">Dónde vives</label>
                  <select id="zona">
                    <option value="peninsula">Península y Baleares (IVA)</option>
                    <option value="canarias">Canarias (IGIC)</option>
                    <option value="ceuta_melilla">Ceuta y Melilla (IPSI)</option>
                  </select>
                </div>
                <div class="field">
                  <label for="bono">Bono social (solo con la PVPC)</label>
                  <select id="bono">
                    <option value="">No tengo bono social</option>
                    <option value="0.425">Vulnerable: 42,5 % de descuento</option>
                    <option value="0.575">Vulnerable severo: 57,5 % de descuento</option>
                  </select>
                </div>
                <div class="field">
                  <label for="bono-lim">Límite anual del bono social</label>
                  <select id="bono-lim">
                    <option value="1587">1.587 kWh</option>
                    <option value="1932">1.932 kWh</option>
                    <option value="2222">2.222 kWh</option>
                    <option value="2698">2.698 kWh</option>
                    <option value="4761">4.761 kWh</option>
                  </select>
                  <span class="hint">Viene en tu factura de la PVPC; depende de tu unidad familiar.</span>
                </div>
              </div>
            </details>
            <div>
              <button class="btn btn--mint" type="submit" id="calcular" disabled>Ver el ranking de tarifas</button>
              <p class="caption" style="margin-top:8px" id="calcular-ayuda">Primero sube tu fichero, prueba con el de ejemplo o usa los datos de tu factura.</p>
            </div>
          </form>
        </li>
      </ol>

      <div id="resultado" class="resultado" hidden tabindex="-1" aria-live="polite"></div>
    </div>
  </section>

  <script type="application/json" id="datos-comparador" set:html={JSON.stringify(datos)} />
</Base>


<script>
  import "../scripts/comparador";
</script>

<style is:global>
  .modos {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
    margin-bottom: 16px;
  }
  .modo {
    display: flex;
    flex-direction: column;
    gap: 2px;
    text-align: left;
    padding: 12px 16px;
    min-height: 64px;
    border: 1px solid var(--color-pale-sage);
    border-radius: var(--radius-buttons);
    background: var(--color-sheet-white);
    font: inherit;
    color: var(--color-bark);
    cursor: pointer;
  }
  .modo span {
    font-size: 13px;
    color: var(--color-slate);
  }
  .modo strong {
    font-weight: var(--font-weight-medium);
  }
  .modo[aria-selected="true"] {
    border-color: var(--color-canopy);
    box-shadow: inset 0 -3px 0 var(--color-mint-pulse);
    background: #f2f7f5;
  }
  .seg-f {
    border: 0;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px 24px;
  }
  .seg-f legend {
    width: 100%;
    margin-bottom: 8px;
  }
  .perfiles-ayuda {
    margin: 4px 0 0;
    padding-left: 1.1em;
  }
  .avanzado {
    border-top: 1px solid var(--color-pale-sage);
    padding-top: 8px;
  }
  .avanzado input[type="range"] {
    width: 100%;
    accent-color: var(--color-canopy);
    min-height: 32px;
  }
  .res-h2 {
    font-size: 32px;
    margin: 56px 0 8px;
  }
  .res-h2 + .muted {
    margin-bottom: 20px;
  }
  .privacidad {
    display: flex;
    gap: 10px;
    align-items: flex-start;
    margin-top: 24px;
    padding: 12px 16px;
    background: var(--color-sheet-white);
    border: 1px solid var(--color-sage-mist);
    border-radius: var(--radius-buttons);
    max-width: 62ch;
    font-size: 15px;
    color: var(--color-canopy);
  }
  .privacidad svg {
    flex: none;
    margin-top: 1px;
  }
  .paso__t {
    font-size: var(--text-heading-sm);
    font-weight: var(--font-weight-medium);
    color: var(--color-bark);
    margin-bottom: 12px;
    line-height: 1.3;
  }
  .paso > p + p {
    margin-top: 8px;
  }
  .comparador .pasos {
    max-width: 800px;
    gap: 48px;
  }
  .dropzone {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    padding: 32px 16px;
    border: 2px dashed var(--color-sage-mist);
    border-radius: var(--radius-cards);
    background: var(--color-sheet-white);
    text-align: center;
    cursor: pointer;
    transition: border-color 0.15s, background-color 0.15s;
  }
  .dropzone:hover,
  .dropzone.is-over,
  .dropzone:focus-within {
    border-color: var(--color-canopy);
    background: #f7fbf9;
  }
  .dropzone:focus-within {
    outline: 3px solid var(--color-orb-violet);
    outline-offset: 2px;
  }
  .dropzone__icono {
    color: var(--color-canopy);
  }
  .dropzone__t {
    font-weight: var(--font-weight-medium);
    color: var(--color-canopy);
  }
  #estado-fichero:not(:empty) {
    margin-top: 16px;
  }
  .otra {
    border: 1px solid var(--color-sage-mist);
    border-radius: var(--radius-cards);
    padding: 16px 20px 20px;
    margin: 0;
    background: var(--color-sheet-white);
  }
  .otra legend {
    font-weight: var(--font-weight-medium);
    padding: 0 6px;
    font-size: 15px;
  }
  .resultado {
    margin-top: 64px;
    scroll-margin-top: 88px;
  }
  .resultado:focus {
    outline: none;
  }
  .res-cab {
    background: var(--color-sheet-white);
    border: 1px solid var(--color-sage-mist);
    border-radius: var(--radius-cards);
    padding: 32px 24px;
  }
  @media (min-width: 768px) {
    .res-cab {
      padding: 48px;
    }
  }
  .res-cab .answer {
    margin: 12px 0 16px;
  }
  .ranking {
    list-style: none;
    margin: 24px 0 0;
    padding: 0;
    display: grid;
    gap: 12px;
  }
  .tar {
    background: var(--color-sheet-white);
    border: 1px solid var(--color-sage-mist);
    border-radius: var(--radius-cards);
    padding: 20px;
  }
  .tar--actual {
    border-color: var(--color-canopy);
    box-shadow: inset 4px 0 0 var(--color-canopy);
  }
  .tar__top {
    display: grid;
    grid-template-columns: 32px minmax(0, 1fr) auto;
    gap: 12px;
    align-items: start;
  }
  .tar__pos {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: var(--color-cream-paper);
    border: 1px solid var(--color-sage-mist);
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: var(--font-weight-medium);
    font-size: 14px;
  }
  .tar:first-child .tar__pos {
    background: var(--color-mint-pulse);
    border-color: var(--color-mint-pulse);
  }
  .tar__nombre {
    font-weight: var(--font-weight-medium);
    font-size: 18px;
    line-height: 1.3;
  }
  .tar__com {
    font-size: 14px;
    color: var(--color-slate);
  }
  .tar__badges {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 8px;
  }
  .tar__total {
    text-align: right;
  }
  .tar__total strong {
    display: block;
    font-size: 24px;
    font-weight: var(--font-weight-medium);
    font-variant-numeric: tabular-nums;
  }
  .tar__total span {
    font-size: 13px;
    color: var(--color-slate);
    white-space: nowrap;
  }
  .tar__dif {
    font-size: 14px;
    font-weight: var(--font-weight-medium);
  }
  .tar__dif--mas {
    color: var(--color-orb-violet);
  }
  .tar__dif--menos {
    color: var(--color-canopy);
  }
  .tar details {
    margin-top: 12px;
    border-top: 1px solid var(--color-pale-sage);
    padding-top: 4px;
  }
  .tar__detalle {
    display: grid;
    gap: 16px;
    padding: 8px 0 4px;
  }
  @media (min-width: 720px) {
    .tar__detalle {
      grid-template-columns: 1fr 1fr;
    }
  }
  .desglose {
    width: 100%;
    font-size: 14px;
  }
  .desglose td {
    padding: 4px 0;
    border: 0;
  }
  .desglose tr.total td {
    border-top: 1px solid var(--color-pale-sage);
    font-weight: var(--font-weight-medium);
    padding-top: 8px;
  }
  .extras {
    margin-top: 48px;
  }
  .extras h3 {
    margin-bottom: 8px;
  }
  .solar-cta {
    display: flex;
    flex-direction: column;
    gap: 24px;
    align-items: flex-start;
  }
  @media (min-width: 900px) {
    .solar-cta {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
  }
  .extras .answer {
    margin: 0;
  }
  .mapeo-grid {
    display: grid;
    gap: 12px;
    margin-top: 12px;
  }
  @media (min-width: 640px) {
    .mapeo-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
</style>
