# Cabeceras de la web estática (Cloudflare Workers Static Assets). Este fichero no se publica como página.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()

# Ficheros con huella en el nombre: no cambian nunca, se pueden guardar un año.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/logos/*
  Cache-Control: public, max-age=604800

# La dirección de pruebas *.workers.dev no debe aparecer en Google (el sitio bueno es comparadortarifaluz.es).
https://:worker.:cuenta.workers.dev/*
  X-Robots-Tag: noindex
