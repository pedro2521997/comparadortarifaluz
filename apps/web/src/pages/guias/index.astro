---
import Base from "../../layouts/Base.astro";
import Anuncio from "../../components/Anuncio.astro";
import Tarjeta from "../../components/Tarjeta.astro";
import { guias, CATEGORIAS } from "../../lib/guias";
import { ICONO_CATEGORIA } from "../../lib/iconos";
import { fechaCorta } from "../../lib/formato";

const grupos = CATEGORIAS.map((c) => ({ c, lista: guias.filter((g) => (g.categoria ?? "Tu factura") === c) })).filter((g) => g.lista.length);
const schema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: "Guías sobre la factura de la luz",
  hasPart: guias.map((g) => ({ "@type": "Article", headline: g.titulo, url: `/guias/${g.slug}/` })),
};
---

<Base
  titulo="Guías de la luz: factura, tarifas, placas solares y ahorro"
  descripcion={`${guias.length} guías claras y con datos sobre la factura de la luz, las tarifas, cómo descargar tu consumo, las placas solares, el coche eléctrico y cómo ahorrar.`}
  schema={schema}
  migas={[["Guías"]]}
>
  <section class="hero hero--compacto">
    <div class="wrap">
      <span class="eyebrow">Guías</span>
      <h1>Todo lo que rodea a tu factura, sin relleno</h1>
      <p class="lead">{guias.length} guías con datos y ejemplos en euros. Cada una termina en una herramienta o en una decisión, con fuentes oficiales y fecha de revisión. Pulsa una tarjeta para ver la respuesta corta.</p>
      <nav class="cats" aria-label="Temas">
        {grupos.map((g) => <a class="pill" href={`#${g.c.toLowerCase().replace(/[^a-záéíóúñ]+/g, "-")}`}>{g.c}</a>)}
      </nav>
    </div>
  </section>
  <section class="section section--tight">
    <div class="wrap stack" style="--stack:48px">
      {
        grupos.map((g, i) => (
          <>
            <div id={g.c.toLowerCase().replace(/[^a-záéíóúñ]+/g, "-")}>
              <h2 class="g-cat">{g.c}</h2>
              <ul class="flip-rejilla g-rejilla">
                {g.lista.map((x) => (
                  <li>
                    <Tarjeta etiqueta={x.titulo} tono="salvia">
                      <Fragment slot="frente">
                        <span class="flip__img" aria-hidden="true">{ICONO_CATEGORIA[g.c] ?? "📘"}</span>
                        <h3 class="g__t">{x.titulo}</h3>
                        <p class="muted small">{x.resumen}</p>
                        <span class="caption g__rev">Revisada el {fechaCorta(x.revisado)}</span>
                      </Fragment>
                      <Fragment slot="dorso">
                        <span class="flip__dato">En pocas palabras</span>
                        <p class="g__resp">{x.respuesta ?? x.resumen}</p>
                        <a href={`/guias/${x.slug}/`}>Leer la guía completa →</a>
                      </Fragment>
                    </Tarjeta>
                  </li>
                ))}
              </ul>
            </div>
            {i % 2 === 1 && i < grupos.length - 1 && <Anuncio tipo="horizontal" />}
          </>
        ))
      }
    </div>
  </section>
</Base>

<style>
  .cats {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 24px;
  }
  .cats .pill {
    text-decoration: none;
    font-size: 12px;
  }
  .g-cat {
    font-size: 28px;
    margin-bottom: 16px;
    scroll-margin-top: 88px;
  }
  .g__t {
    font-size: 19px;
    font-weight: 500;
    color: var(--color-bark);
    letter-spacing: 0;
    line-height: 1.3;
  }
  .g-rejilla {
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
  }
  .g__rev {
    margin-top: auto;
  }
  .g__resp {
    font-size: 15px;
    line-height: 1.45;
  }
</style>
