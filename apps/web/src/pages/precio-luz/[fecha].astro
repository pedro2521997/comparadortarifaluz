---
// Archivo histórico: una página por día con datos reales. Nunca se generan páginas vacías.
// Es la página que Google enseña para «precio luz 26 octubre 2026», también cuando ese día es hoy o mañana.
import Base from "../../layouts/Base.astro";
import Anuncio from "../../components/Anuncio.astro";
import MasSobrePrecio from "../../components/MasSobrePrecio.astro";
import PrecioDia from "../../components/PrecioDia.astro";
import ResumenDia from "../../components/ResumenDia.astro";
import { dias, type DiaPrecios } from "../../lib/datos";
import { fechaLarga, fechaCorta, sumarDias } from "../../lib/formato";
import { infoDia, tituloDia, descripcionDia, entradillaDia, preguntasDia, esquemaDia } from "../../lib/dia";
import { esquemaFaq } from "../../lib/faq";
import { SITIO } from "../../config";

export function getStaticPaths() {
  return dias.map((dia) => ({ params: { fecha: dia.fecha }, props: { dia } }));
}

const { dia } = Astro.props as { dia: DiaPrecios };
const i = infoDia(dia.fecha)!;
const fechas = new Set(dias.map((d) => d.fecha));
const anterior = sumarDias(dia.fecha, -1);
const siguiente = sumarDias(dia.fecha, 1);
const schema = [esquemaDia(i, new URL(`/precio-luz/${dia.fecha}/`, SITIO.url).href), esquemaFaq(preguntasDia(i))];
const enVivo = i.etiqueta === "hoy" ? "/precio-luz-hoy/" : i.etiqueta === "mañana" ? "/precio-luz-manana/" : null;
---

<Base titulo={tituloDia(i, "archivo")} descripcion={descripcionDia(i, "archivo")} schema={schema} migas={[["Precio de la luz", "/precio-luz/"], [fechaCorta(dia.fecha)]]}>
  <section class="hero hero--compacto">
    <div class="wrap">
      <p class="breadcrumbs"><a href="/precio-luz/">Archivo de precios</a> / {fechaCorta(dia.fecha)}</p>
      <h1>Precio de la luz {i.etiqueta === "hoy" || i.etiqueta === "mañana" ? `${i.etiqueta}, ` : "del "}{fechaLarga(dia.fecha)}</h1>
      <p class="lead">{entradillaDia(i)}</p>
      <div class="btn-row">
        {fechas.has(anterior) && <a class="btn btn--ghost btn--small" href={`/precio-luz/${anterior}/`}>← {fechaCorta(anterior)}</a>}
        {fechas.has(siguiente) && <a class="btn btn--ghost btn--small" href={`/precio-luz/${siguiente}/`}>{fechaCorta(siguiente)} →</a>}
        <a class="btn btn--ghost btn--small" href={enVivo ?? "/precio-luz-hoy/"}>{enVivo ? "Con la hora actual" : "Hoy"}</a>
      </div>
    </div>
  </section>
  <section class="section section--tight">
    <div class="wrap">
      <PrecioDia fecha={dia.fecha} modo="archivo" />
    </div>
  </section>
  <Anuncio tipo="horizontal" seccion />
  <ResumenDia i={i} />
  <Anuncio tipo="horizontal" seccion />
  <MasSobrePrecio fecha={dia.fecha} />
</Base>
