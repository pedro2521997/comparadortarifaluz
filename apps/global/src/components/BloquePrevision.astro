---
// Previsión de eólica, solar y demanda de un día (ENTSO-E): resumen en texto y gráfica hora a hora.
// Va en la página de «mañana» y en la del mix: explica por qué la luz será barata o cara.
import { graficaLineas } from "../../../web/src/lib/compartido/grafica-svg";
import { textosE, resumenPrevision } from "../lib/energia";
import type { Mercado } from "../lib/datos";

interface Props {
  m: Mercado;
  p: { eolica: (number | null)[] | null; solar: (number | null)[] | null; demanda: (number | null)[] | null };
}
const { m, p } = Astro.props;
const T = textosE(m);
const r = resumenPrevision(p);
const n = (x: number) => `${new Intl.NumberFormat(m.pais.locale, { maximumFractionDigits: 1 }).format(x)} GWh`;
const pct = (x: number) => new Intl.NumberFormat(m.pais.locale, { style: "percent", maximumFractionDigits: 0 }).format(x);
const series = [
  ...(p.eolica ? [{ nombre: T.grupos.eolica, valores: p.eolica, color: "#0aa65a" }] : []),
  ...(p.solar ? [{ nombre: T.grupos.solar, valores: p.solar, color: "#e0a800" }] : []),
  ...(p.demanda ? [{ nombre: T.demanda, valores: p.demanda, color: "var(--color-slate)" }] : []),
];
const hay = r.eolica + r.solar > 0;
---

{
  hay && (
    <section class="section section--white section--tight">
      <div class="wrap wrap--narrow">
        <h2 style="font-size:22px;margin-bottom:8px">{T.previsionT}</h2>
        <p class="muted" style="margin-bottom:12px">{T.prevTexto(n(r.eolica), n(r.solar), r.pct !== null ? pct(r.pct) : null)}</p>
        <Fragment set:html={graficaLineas(series, { etiquetas: Array.from({ length: 24 }, (_, h) => `${String(h).padStart(2, "0")}:00`), formato: (x) => `${Math.round(x).toLocaleString(m.pais.locale)} MW`, resumen: T.previsionT })} />
        <p class="caption">ENTSO-E: Day-ahead Generation Forecasts for Wind and Solar · Day-ahead Total Load Forecast.</p>
      </div>
    </section>
  )
}
