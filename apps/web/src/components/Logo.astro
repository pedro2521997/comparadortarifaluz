---
interface Props {
  blanco?: boolean;
}
const { blanco = false } = Astro.props;
---

<span class:list={["logo", { "logo--blanco": blanco }]}>
  <svg width="28" height="28" viewBox="0 0 32 32" aria-hidden="true">
    <circle cx="16" cy="16" r="16" fill={blanco ? "#ffffff" : "#104336"}></circle>
    <path d="M18 5 9 18h6l-2 9 10-14h-6l1-8z" fill="#0fff87"></path>
  </svg>
  <span class="logo__t">Comparador<strong>TarifaLuz</strong><span class="logo__es">.es</span></span>
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: 20px;
    font-weight: 400;
    letter-spacing: -0.01em;
    color: var(--color-canopy);
  }
  .logo__es {
    font-size: 0.75em;
    color: var(--color-slate);
    margin-left: 1px;
  }
  .logo--blanco .logo__es {
    color: rgba(255, 255, 255, 0.7);
  }
  @media (max-width: 380px) {
    .logo {
      font-size: 17px;
    }
  }
  .logo strong {
    font-weight: 500;
  }
  .logo--blanco {
    color: #fff;
  }
</style>
