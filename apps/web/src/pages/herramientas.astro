---
import Base from "../layouts/Base.astro";
import Anuncio from "../components/Anuncio.astro";
import { GRUPOS_HERRAMIENTAS, HERRAMIENTAS } from "../lib/herramientas";
import { SITIO } from "../config";

const slug = (s: string) => s.toLowerCase().normalize("NFD").replace(/[̀-ͯ]/g, "").replace(/[^a-z]+/g, "-").replace(/^-|-$/g, "");
const schema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: "Herramientas para pagar menos luz",
  itemListElement: HERRAMIENTAS.map((h, i) => ({ "@type": "ListItem", position: i + 1, name: h.t, url: new URL(h.href, SITIO.url).href })),
};
---

<Base
  titulo="Herramientas gratis para pagar menos luz"
  descripcion={`${HERRAMIENTAS.length} herramientas gratis para pagar menos luz: comparador, lector de facturas, bono social, potencia, calefacción, gas y placas solares.`}
  schema={schema}
  migas={[["Herramientas"]]}
>
  <section class="hero hero--compacto">
    <div class="wrap">
      <span class="eyebrow">Herramientas</span>
      <h1>Todo lo que necesitas para pagar menos luz</h1>
      <p class="lead">{HERRAMIENTAS.length} herramientas gratis, sin registro y sin subir tus datos a ningún servidor: todo se calcula en tu navegador.</p>
      <div class="field herr-buscar">
        <label for="herr-q">¿Qué quieres hacer?</label>
        <input id="herr-q" type="search" placeholder="Por ejemplo: factura, bono social, termo, placas…" autocomplete="off" />
      </div>
      <nav class="cats" aria-label="Grupos de herramientas">
        {GRUPOS_HERRAMIENTAS.map((g) => <a class="pill" href={`#${slug(g.titulo)}`}>{g.titulo}</a>)}
      </nav>
    </div>
  </section>
  <section class="section section--tight">
    <div class="wrap stack" style="--stack:48px">
      {
        GRUPOS_HERRAMIENTAS.map((g, i) => (
          <>
            <div id={slug(g.titulo)} data-grupo>
              <h2 class="herr-g">{g.titulo}</h2>
              <div class="grid grid--3">
                {g.items.map((h) => (
                  <a class="card card--link" href={h.href} data-buscar={`${h.t} ${h.d}`.toLowerCase()}>
                    {h.nueva && <span class="pill pill--barata herr-nueva">Nueva</span>}
                    <h3>{h.t}</h3>
                    <p class="muted small">{h.d}</p>
                    <span class="arrow">{h.cta} →</span>
                  </a>
                ))}
              </div>
            </div>
            {i === 1 && <Anuncio tipo="horizontal" />}
          </>
        ))
      }
      <p id="herr-nada" class="muted" hidden>No hay ninguna herramienta con esas palabras. Prueba con otras o mira las <a href="/guias/">guías</a>.</p>
    </div>
  </section>
</Base>

<script>
  const q = document.getElementById("herr-q") as HTMLInputElement;
  const norm = (s: string) => s.toLowerCase().normalize("NFD").replace(/[̀-ͯ]/g, "");
  q.addEventListener("input", () => {
    const palabras = norm(q.value).split(/\s+/).filter(Boolean);
    let alguna = false;
    for (const g of document.querySelectorAll<HTMLElement>("[data-grupo]")) {
      let visibles = 0;
      for (const c of g.querySelectorAll<HTMLElement>("[data-buscar]")) {
        const ok = palabras.every((p) => norm(c.dataset.buscar!).includes(p));
        c.hidden = !ok;
        if (ok) visibles++;
      }
      g.hidden = visibles === 0;
      alguna ||= visibles > 0;
    }
    document.getElementById("herr-nada")!.hidden = alguna;
  });
</script>

<style>
  .herr-g {
    font-size: 28px;
    margin-bottom: 16px;
    scroll-margin-top: 88px;
  }
  .herr-buscar {
    max-width: 520px;
    margin-top: 24px;
  }
  .herr-nueva {
    align-self: flex-start;
  }
  .cats {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 16px;
  }
  .cats .pill {
    text-decoration: none;
    font-size: 12px;
  }
</style>
