---
import Base from "../layouts/Base.astro";
import Anuncio from "../components/Anuncio.astro";
import MasSobrePrecio from "../components/MasSobrePrecio.astro";
import PrecioDia from "../components/PrecioDia.astro";
import ComparaDias from "../components/ComparaDias.astro";
import PlanDia from "../components/PlanDia.astro";
import { hoyMadrid, fechaLarga, fechaCorta, sumarDias } from "../lib/formato";
import { infoDia, tituloDia, descripcionDia } from "../lib/dia";
import { entradillaVivo, preguntasVivo, compararDias, rotulo } from "../lib/dia-vivo";
import { esquemaFaq } from "../lib/faq";

const hoy = hoyMadrid();
const ayer = sumarDias(hoy, -1);
const anteayer = sumarDias(hoy, -2);
const i = infoDia(ayer);
const comp = compararDias([[anteayer, rotulo("Anteayer", anteayer)], [ayer, rotulo("Ayer", ayer)], [hoy, rotulo("Hoy", hoy)]], ayer, hoy, "Hoy, frente a ayer,");
---

<Base
  titulo={i ? tituloDia(i, "ayer") : "Precio de la luz ayer por horas (PVPC)"}
  descripcion={i ? descripcionDia(i, "ayer") : "Precio de la luz de ayer hora a hora, con datos de Red Eléctrica, para comprobar tu factura o comparar con hoy."}
  migas={[["Precio de la luz", "/precio-luz/"], ["Ayer"]]}
  schema={i ? [esquemaFaq(preguntasVivo(i, "ayer"))] : undefined}
>
  <section class="hero hero--compacto">
    <div class="wrap">
      <span class="eyebrow">Precio de la luz ayer</span>
      <h1>Precio de la luz ayer, <span data-fecha-texto>{fechaLarga(ayer)}</span></h1>
      {i ? <p class="lead" data-dia-fijo={ayer}>{entradillaVivo(i, "ayer")}</p> : <p class="lead">Útil para comprobar lo que te costó la lavadora o el coche de anoche.</p>}
      <div class="btn-row">
        <a class="btn btn--ghost" href="/precio-luz-hoy/">Precio de hoy</a>
        <a class="btn btn--ghost" href="/precio-luz/">Archivo de precios</a>
      </div>
    </div>
  </section>
  <section class="section section--tight">
    <div class="wrap">
      <PrecioDia fecha={ayer} modo="ayer" />
      {i && <p class="caption" data-dia-fijo={ayer} style="margin-top:12px">Por qué la luz costó esto y cómo quedó en el mes: <a href={`/precio-luz/${ayer}/`}>análisis del {fechaCorta(ayer)}</a>.</p>}
    </div>
  </section>
  <Anuncio tipo="horizontal" seccion />
  {i && <PlanDia i={i} modo="ayer" />}
  <ComparaDias c={comp} titulo="Ayer frente a anteayer y hoy" fecha={ayer} />
  <MasSobrePrecio fecha={ayer} vivo />
</Base>
