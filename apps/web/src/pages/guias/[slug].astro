---
import Base from "../../layouts/Base.astro";
import Anuncio from "../../components/Anuncio.astro";
import { guias, preguntasDe, relacionadas, conAnuncios, minutosLectura, type Guia } from "../../lib/guias";
import { anuncioHtml } from "../../lib/anuncios-html.mjs";
import { fechaMedia } from "../../lib/formato";
import { SITIO } from "../../config";

export function getStaticPaths() {
  return guias.map((g) => ({ params: { slug: g.slug }, props: { g } }));
}
const { g } = Astro.props as { g: Guia };
// Las tablas de las guías van en un contenedor desplazable para que no ensanchen la página en el móvil.
const conTablas = (await g.md.compiledContent()).replace(/<table>([\s\S]*?)<\/table>/g, '<div class="table-wrap" tabindex="0" role="region" aria-label="Tabla"><table>$1</table></div>');
const html = conAnuncios(conTablas, anuncioHtml("articulo", { dev: import.meta.env.DEV }));
const indice = g.md.getHeadings().filter((h) => h.depth === 2);
const faqs = preguntasDe(g);
const otras = relacionadas(g);
const url = new URL(`/guias/${g.slug}/`, SITIO.url).href;

const articulo = {
  "@context": "https://schema.org",
  "@type": g.howto ? "HowTo" : "Article",
  [g.howto ? "name" : "headline"]: g.titulo,
  description: g.respuesta ?? g.resumen,
  datePublished: g.publicado ?? g.revisado,
  dateModified: g.revisado,
  inLanguage: "es-ES",
  mainEntityOfPage: url,
  author: { "@type": "Organization", name: SITIO.nombre, url: SITIO.url },
  publisher: { "@type": "Organization", name: SITIO.nombre, url: SITIO.url },
  citation: g.fuentes.map((f) => f.url),
};
const schema = faqs.length && g.faq !== true
  ? [articulo, { "@context": "https://schema.org", "@type": "FAQPage", mainEntity: faqs.map((p) => ({ "@type": "Question", name: p.q, acceptedAnswer: { "@type": "Answer", text: p.a } })) }]
  : g.faq === true
    ? { "@context": "https://schema.org", "@type": "FAQPage", mainEntity: faqs.map((p) => ({ "@type": "Question", name: p.q, acceptedAnswer: { "@type": "Answer", text: p.a } })) }
    : articulo;
---

<Base titulo={g.titulo_seo ?? g.titulo} descripcion={g.resumen} schema={schema} migas={[["Guías", "/guias/"], [g.titulo]]}>
  <section class="hero hero--compacto">
    <div class="wrap guia-wrap">
      <p class="breadcrumbs"><a href="/guias/">Guías</a>{g.categoria && <> / {g.categoria}</>}</p>
      <h1 class="guia-h1">{g.titulo}</h1>
      <p class="lead">{g.resumen}</p>
      <p class="caption guia-meta">Actualizada el <time datetime={g.revisado}>{fechaMedia(g.revisado)}</time> · {minutosLectura(g.md)} min de lectura · Por el equipo de {SITIO.nombre}</p>
    </div>
  </section>
  <section class="section section--white section--tight">
    <div class="wrap guia-grid">
      <article class="guia-art">
        {
          g.respuesta && (
            <div class="respuesta" role="note">
              <p class="respuesta__t">En pocas palabras</p>
              <p>{g.respuesta}</p>
            </div>
          )
        }
        {
          indice.length >= 4 && (
            <nav class="indice" aria-label="Índice de la guía">
              <details open>
                <summary>En esta guía</summary>
                <ol>{indice.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol>
              </details>
            </nav>
          )
        }
        <div class="prose" set:html={html} />

        {
          faqs.length > 0 && g.faq !== true && (
            <section class="faqs" aria-labelledby="faqs-t">
              <h2 id="faqs-t">Preguntas frecuentes</h2>
              {faqs.map((p) => (
                <details class="faq">
                  <summary>{p.q}</summary>
                  <p>{p.a}</p>
                </details>
              ))}
            </section>
          )
        }

        <div class="card card--roomy guia-cta">
          <span class="eyebrow">Pásalo a números</span>
          <p class="guia-cta__t">{g.herramienta.texto}</p>
          <a class="btn btn--mint" href={g.herramienta.href}>Ir a la herramienta</a>
        </div>

        <div class="fuentes-guia">
          <h2 class="eyebrow">Fuentes</h2>
          <ul class="small">
            {g.fuentes.map((f) => <li><a href={f.url} rel="noopener">{f.nombre}</a></li>)}
          </ul>
        </div>
      </article>
      <aside class="guia-lado" aria-label="Más contenido">
        <div class="guia-lado__fijo">
          <div class="card stack" style="--stack:10px">
            <p class="eyebrow">Herramientas gratis</p>
            <ul class="lado-links">
              <li><a href="/comparador/">Comparar mi tarifa</a></li>
              <li><a href="/calcular-factura-luz/">Calcular mi factura</a></li>
              <li><a href="/precio-luz-hoy/">Precio de la luz hoy</a></li>
              <li><a href="/tarifas/">Ranking de tarifas</a></li>
            </ul>
          </div>
          <Anuncio tipo="lateral" />
        </div>
      </aside>
    </div>
  </section>
  <section class="section section--tight">
    <div class="wrap">
      <h2 style="font-size:28px;margin-bottom:16px">Sigue leyendo</h2>
      <div class="grid grid--3">
        {otras.map((o) => <a class="card card--link" href={`/guias/${o.slug}/`}><strong>{o.titulo}</strong><span class="muted small">{o.resumen}</span><span class="arrow">Leer →</span></a>)}
      </div>
    </div>
  </section>
</Base>

<style>
  .guia-wrap {
    max-width: 1100px;
  }
  .guia-h1 {
    font-size: clamp(32px, 6vw, 48px);
    max-width: 22ch;
  }
  .guia-meta {
    margin-top: 16px;
  }
  .guia-grid {
    max-width: 1100px;
    display: grid;
    gap: 40px;
  }
  @media (min-width: 1100px) {
    .guia-grid {
      grid-template-columns: minmax(0, 1fr) 300px;
    }
  }
  .guia-art {
    min-width: 0;
    max-width: 72ch;
  }
  .guia-lado {
    display: none;
  }
  @media (min-width: 1100px) {
    .guia-lado {
      display: block;
    }
    .guia-lado__fijo {
      position: sticky;
      top: 88px;
      display: grid;
      gap: 24px;
    }
  }
  .lado-links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 8px;
  }
  .respuesta {
    border-left: 4px solid var(--color-mint-pulse);
    background: #f2faf6;
    padding: 16px 20px;
    border-radius: 0 var(--radius-buttons) var(--radius-buttons) 0;
    margin-bottom: 24px;
    font-size: 17px;
    line-height: 1.6;
  }
  .respuesta__t {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--color-canopy);
    margin-bottom: 6px;
  }
  .indice {
    border: 1px solid var(--color-sage-mist);
    border-radius: var(--radius-buttons);
    padding: 8px 16px;
    margin-bottom: 24px;
    background: var(--color-cream-paper);
  }
  .indice ol {
    margin: 8px 0 8px;
    padding-left: 1.3em;
    display: grid;
    gap: 4px;
    font-size: 15px;
  }
  .faqs {
    margin-top: 40px;
  }
  .faqs h2 {
    font-size: 28px;
    margin-bottom: 12px;
  }
  .faq {
    border-bottom: 1px solid var(--color-pale-sage);
    padding: 6px 0;
  }
  .faq summary {
    color: var(--color-bark);
  }
  .faq p {
    padding: 4px 0 12px 20px;
    color: var(--color-charcoal);
  }
  .guia-cta {
    margin-top: 48px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    align-items: flex-start;
    background: var(--color-cream-paper);
  }
  .guia-cta__t {
    font-size: 24px;
    font-weight: 300;
    color: var(--color-ink);
  }
  .fuentes-guia {
    margin-top: 40px;
  }
  .fuentes-guia ul {
    margin-top: 8px;
    padding-left: 1.2em;
  }
</style>
