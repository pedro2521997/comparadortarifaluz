---
// Mix de generación de una zona: de dónde viene la electricidad hoy (ENTSO-E, generación real por tecnología),
// % renovable, CO₂ estimado, producción hora a hora, últimos 30 días y previsión de eólica y solar para mañana.
import Base from "../layouts/Base.astro";
import Anuncio from "./Anuncio.astro";
import BloquePrevision from "./BloquePrevision.astro";
import { TEXTOS } from "../lib/textos";
import { fechaLocal, sumarDias } from "../lib/bloque";
import { recortarFrases, detalleIndexable, etiquetaZona, hoyDe, MERCADOS, urlManana, esquemaFaq, type Mercado } from "../lib/datos";
import { textosE, mixUltimo, mixCompletoUltimo, totales, renovable30, urlNegativos, urlMeses, urlMix, previsionDe } from "../lib/energia";
import { barrasApiladas, barraReparto } from "../lib/grafica-mix";
import { lista } from "../lib/textos-carburantes";
import { graficaLineas } from "../../../web/src/lib/compartido/grafica-svg";
import type { Grupo } from "../lib/textos-energia";

interface Props {
  m: Mercado;
}
const { m } = Astro.props;
const L = TEXTOS[m.pais.lang];
const T = textosE(m);
const d = mixUltimo(m)!;
const t = totales(d);
const ayer = mixCompletoUltimo(m);
const tAyer = ayer && ayer.fecha !== d.fecha ? totales(ayer) : null;
const pct = (x: number) => new Intl.NumberFormat(m.pais.locale, { style: "percent", maximumFractionDigits: 0 }).format(x);
const gwh = (x: number) => `${new Intl.NumberFormat(m.pais.locale, { maximumFractionDigits: 1 }).format(x / 1000)} GWh`;
const z = etiquetaZona(m);
const esHoy = d.fecha === hoyDe(m);
const cuando = esHoy ? T.hoy : fechaLocal(d.fecha, m.pais.locale);
const fechaL = fechaLocal(d.fecha, m.pais.locale);
const sep = m.pais.lang === "fr" ? " : " : ": ";
const top = lista(m.pais.lang, t.grupos.slice(0, 3).map(([g, v]) => `${T.grupos[g]} (${pct(v / t.total)})`), T.y);
const orden = t.grupos.map(([g]) => g) as Grupo[];
const r30 = renovable30(m);
const manana = sumarDias(hoyDe(m), 1);
const prev = previsionDe(m.zona.id, manana);
const hermanas = MERCADOS.filter((x) => x.pais.cc === m.pais.cc && x !== m);
const preguntas = [
  { p: T.pMix, r: T.rMix(pct(t.renovable), top) },
  { p: T.pCo2, r: T.rCo2(Math.round(t.co2).toLocaleString(m.pais.locale)) },
];
const cab = [T.mix, z, cuando].filter(Boolean).join(" ");
const titulo = [`${cab} ${esHoy ? fechaL : ""}`.trim() + `${sep}${T.pctRenovTitulo(pct(t.renovable))}`, `${cab}${sep}${T.pctRenovTitulo(pct(t.renovable))}`, cab].find((x) => x.length <= 70) ?? cab;
const lead = T.rMix(pct(t.renovable), top);
const desc = recortarFrases(lead, 158);
---

<Base titulo={titulo} descripcion={desc} lang={m.pais.lang} locale={m.pais.locale} schema={esquemaFaq(preguntas)} noindex={!detalleIndexable(m)}>
  <section class="hero hero--compacto">
    <div class="wrap">
      <span class="eyebrow">{m.pais.nombre}{z && ` · ${m.zona.nombre}`} · {fechaL}{esHoy && t.horas < 24 && ` · ${T.hasta(L.reloj(t.horas))}`}</span>
      <h1>{cab}</h1>
      <p class="lead">{lead}</p>
      <div class="btn-row">
        <a class="btn btn--ghost btn--small" href={m.ruta}>{L.precio} {L.hoy}</a>
        <a class="btn btn--ghost btn--small" href={urlManana(m)}>{L.precio} {L.manana}</a>
        <a class="btn btn--ghost btn--small" href={urlNegativos(m)}>{T.negativosT}</a>
        <a class="btn btn--ghost btn--small" href={urlMeses(m)}>{T.mesesT}</a>
      </div>
    </div>
  </section>

  <section class="section section--tight">
    <div class="wrap stack" style="--stack:32px">
      <div class="grid grid--4 stats">
        <div class="stat"><span class="stat__label">{T.renovable}</span><span class="stat__value">{pct(t.renovable)}</span><span class="stat__sub">{tAyer && `${T.ayer}${sep}${pct(tAyer.renovable)}`}</span></div>
        <div class="stat"><span class="stat__label">{T.bajasEmisiones}</span><span class="stat__value">{pct(t.bajasEmisiones)}</span><span class="stat__sub">{tAyer && `${T.ayer}${sep}${pct(tAyer.bajasEmisiones)}`}</span></div>
        <div class="stat"><span class="stat__label">{T.co2}</span><span class="stat__value">{Math.round(t.co2)}<small> g/kWh</small></span><span class="stat__sub">{T.estimado}</span></div>
        <div class="stat"><span class="stat__label">{T.produccion}</span><span class="stat__value" style="font-size:28px">{gwh(t.total)}</span><span class="stat__sub">{esHoy && t.horas < 24 ? T.hasta(L.reloj(t.horas)) : ""}</span></div>
      </div>
      <div>
        <Fragment set:html={barraReparto(t.grupos, T.grupos, pct, sep)} />
      </div>
      <div>
        <h2 style="font-size:22px;margin-bottom:12px">{T.produccionHoras}</h2>
        <Fragment set:html={barrasApiladas(d.horas, orden, T.grupos, `${cab}: ${top}`, m.pais.locale)} />
      </div>
    </div>
  </section>

  <Anuncio tipo="horizontal" seccion />

  {prev && <BloquePrevision m={m} p={prev} />}

  {
    r30.length > 5 && (
      <section class="section section--tight">
        <div class="wrap wrap--narrow">
          <h2 style="font-size:22px;margin-bottom:12px">{T.ultimos30}</h2>
          <Fragment set:html={graficaLineas([{ nombre: T.renovable, valores: r30.map((x) => x.valor * 100) }], { etiquetas: r30.map((x) => fechaLocal(x.fecha, m.pais.locale).replace(/\s?\d{4}$/, "")), formato: (n) => pct(n / 100), resumen: T.ultimos30 })} />
        </div>
      </section>
    )
  }

  <Anuncio tipo="horizontal" seccion />

  <section class="section section--white">
    <div class="wrap wrap--narrow">
      {preguntas.map((q) => (
        <details class="g-faq" open>
          <summary>{q.p}</summary>
          <p>{q.r}</p>
        </details>
      ))}
      {
        hermanas.length > 0 && (
          <p class="small" style="margin-top:20px">
            {hermanas.map((x, i) => (
              <>
                {i > 0 && " · "}
                <a href={urlMix(x)}>{T.mix} {x.zona.nombre}</a>
              </>
            ))}
          </p>
        )
      }
      <p class="caption" style="margin-top:16px">{T.fuenteMix} {T.co2}{sep}{T.estimado}.</p>
    </div>
  </section>
</Base>

<style>
  .g-faq {
    border-bottom: 1px solid var(--color-pale-sage);
    padding: 6px 0;
  }
  .g-faq summary {
    color: var(--color-bark);
    cursor: pointer;
  }
  .g-faq p {
    padding: 4px 0 12px 20px;
  }
</style>
