---
// Plantilla de la web global. Usa los estilos de la web española (mismo diseño) y añade idioma, hreflang
// y el selector de país. AdSense igual que en la web española (lib/anuncios-html.mjs + anuncios.json).
import "../../../web/src/styles/global.css";
import "../../../web/src/styles/componentes.css";
import Anuncio from "../components/Anuncio.astro";
import Logo from "../components/Logo.astro";
import MarcaCtl from "../components/MarcaCtl.astro";
import { SITIO } from "../config";
import { PAISES_CON_DATOS } from "../lib/datos";
import { PAISES_C, textosC, urlPrecios, urlEuropa, en, CC } from "../lib/carburantes";
import { GUIAS, urlGuias, TITULO_GUIAS } from "../lib/guias";
import { PAISES, MERCADOS, absoluta } from "../lib/datos";
import { tieneMapas, urlMapa } from "../lib/mapa";
import { TEXTOS_M } from "../lib/textos-mapa";
import { zonasDe, urlZonas } from "../lib/zonas";
import { TEXTOS, type Idioma } from "../lib/textos";
import { codigoAdsense, clienteAdsense, cuentaAdsense } from "../lib/anuncios-html.mjs";
// La fuente del texto (alfabeto latino básico) se pide junto al HTML, sin esperar a la hoja de estilos.
import fuente from "@fontsource-variable/dm-sans/files/dm-sans-latin-wght-normal.woff2?url";

interface Props {
  titulo: string;
  descripcion: string;
  lang: Idioma;
  /** «nb-NO», «de-AT»… (para og:locale) */
  locale?: string;
  schema?: Record<string, unknown> | Record<string, unknown>[];
  alternativas?: { lang: string; href: string }[];
  anuncioFinal?: boolean;
  noindex?: boolean;
  /** Migas de pan para Google: [nombre, ruta] y la última sin ruta. */
  migas?: [string, string?][];
}
const { titulo, descripcion, lang, locale = "en", schema, alternativas = [], anuncioFinal = true, noindex = false, migas = [] } = Astro.props;
const canonical = new URL(Astro.url.pathname, SITIO.url).href;
const tituloCompleto = titulo.length > 50 ? titulo : `${titulo} | ${SITIO.nombre}`;
const esquemas = schema ? (Array.isArray(schema) ? schema : [schema]) : [];
if (migas.length)
  esquemas.push({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: migas.map(([nombre, r], i) => ({ "@type": "ListItem", position: i + 1, name: nombre, ...(r ? { item: absoluta(r) } : {}) })),
  });
const L = TEXTOS[lang];
const ruta = Astro.url.pathname;
const PRERENDER = { prerender: [{ where: { and: [{ href_matches: "/*" }, { not: { href_matches: "/data/*" } }, { not: { selector_matches: "[rel~=nofollow]" } }] }, eagerness: "moderate" }] };

// Menú de la sección del país en que se está (/de/…, /es/…): luz, carburantes, mapa, Europa y guías, en su idioma.
const sec = PAISES.find((p) => ruta.startsWith(`/${p.cc}/`));
const Ls = sec ? TEXTOS[sec.lang] : L;
const guiaCc = sec ? GUIAS.find((g) => g.lang === sec.lang)?.cc : undefined;
const tieneLuz = sec && MERCADOS.some((m) => m.pais.cc === sec.cc && m.principal);
// «externo»: la luz de España está en ComparadorTarifaLuz.es; se abre en otra pestaña y lleva su símbolo.
const menu: { href: string; t: string; activo: boolean; externo?: boolean }[] = !sec
  ? []
  : [
      ...(tieneLuz ? [{ href: `/${sec.cc}/`, t: Ls.precio, activo: false }] : sec.cc === "es" ? [{ href: SITIO.espana, t: Ls.precio, activo: false, externo: true }] : []),
      ...(PAISES_C.includes(sec) ? [{ href: urlPrecios(sec), t: Ls.carburantes, activo: ruta.startsWith(urlPrecios(sec)) || ruta.includes("/gasolineras-baratas/") || (!!zonasDe(sec) && ruta.startsWith(urlZonas(zonasDe(sec)!))) || /\/precio-(gasoil|glp)-hoy\//.test(ruta) || ruta.startsWith(`/${sec.cc}/${textosC(sec).slugCalefaccion}/`) }] : []),
      ...(tieneMapas(sec) ? [{ href: urlMapa(sec), t: TEXTOS_M[sec.lang]!.boton, activo: ruta.startsWith(urlMapa(sec)) }] : []),
      ...(PAISES_C.includes(sec) ? [{ href: urlEuropa(sec), t: textosC(sec).tituloEuropa, activo: ruta.startsWith(urlEuropa(sec)) }] : []),
      ...(guiaCc ? [{ href: urlGuias(guiaCc), t: TITULO_GUIAS[sec.lang], activo: ruta.includes("/guide/") }] : []),
    ];
if (menu.length && tieneLuz && !menu.some((x) => x.activo)) menu[0].activo = true;
// Selector de país: los que tienen precio de la luz y España (carburantes; la luz está en la web española).
// Pie: «Quiénes somos» y «Contacto». Las páginas están en español y en inglés; los demás idiomas enlazan a las inglesas.
const ACERCA: Record<Idioma, [string, string]> = {
  no: ["Om oss", "Kontakt"], sv: ["Om oss", "Kontakt"], da: ["Om os", "Kontakt"], fi: ["Tietoa meistä", "Yhteystiedot"], de: ["Über uns", "Kontakt"],
  pt: ["Quem somos", "Contacto"], fr: ["À propos", "Contact"], it: ["Chi siamo", "Contatti"], nl: ["Over ons", "Contact"], es: ["Quiénes somos", "Contacto"], en: ["About us", "Contact"],
};
const enEspanol = lang === "es";
const paisesMenu = PAISES.filter((p) => PAISES_CON_DATOS.includes(p) || p.cc === "es");
---

<!doctype html>
<html lang={lang === "no" ? "nb" : lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{tituloCompleto}</title>
    <link rel="preload" href={fuente} as="font" type="font/woff2" crossorigin />
    <meta name="description" content={descripcion} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    {alternativas.map((a) => <link rel="alternate" hreflang={a.lang} href={a.href} />)}
    <link rel="icon" href="/favicon.ico?v=3" sizes="32x32" />
    <link rel="icon" href="/favicon.svg?v=3" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#EA580C" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={locale.replace("-", "_")} />
    <meta property="og:site_name" content={SITIO.nombre} />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={absoluta("/logo.png")} />
    <meta name="twitter:card" content="summary" />
    <slot name="head" />
    {/* Al pasar el dedo o el ratón por un enlace, el navegador va preparando la página: se abre al instante. */}
    <script is:inline type="speculationrules" set:html={JSON.stringify(PRERENDER)} />
    {esquemas.length > 0 && <script type="application/ld+json" set:html={JSON.stringify(esquemas.length === 1 ? esquemas[0] : esquemas)} />}
    {cuentaAdsense() && <meta name="google-adsense-account" content={cuentaAdsense()} />}
    {codigoAdsense() && <script async src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${clienteAdsense()}`} crossorigin="anonymous" />}
  </head>
  <body>
    <a class="sr-only" href="#contenido">Skip to content</a>
    <header class="nav">
      <div class="wrap nav__in g-nav">
        <a href={sec ? `/${sec.cc}/` : "/"} class="g-logo" aria-label={`${SITIO.nombre}, ${sec ? sec.nombre : "home"}`}><Logo /></a>
        <details class="g-selector">
          <summary aria-label="Country / language"><span aria-hidden="true">🌐</span> {sec ? sec.cc.toUpperCase() : "EN"} <span aria-hidden="true" class="g-flecha">▾</span></summary>
          <ul>
            {paisesMenu.map((p) => (
              <li>
                <a href={`/${p.cc}/`} hreflang={p.locale} lang={p.lang === "no" ? "nb" : p.lang} aria-current={sec === p ? "page" : undefined}>
                  <span class="g-cc">{p.cc.toUpperCase()}</span> {p.nombre}
                </a>
              </li>
            ))}
          </ul>
        </details>
      </div>
      {
        menu.length > 0 && (
          <nav class="g-menu" aria-label={sec?.nombre}>
            <div class="wrap g-menu__in">
              {menu.map((x) => (
                x.externo ? (
                  <a href={x.href} target="_blank" rel="noopener" class="g-externo" title="ComparadorTarifaLuz.es">
                    <MarcaCtl />
                    {x.t}
                    <span class="g-externo__flecha" aria-hidden="true">↗</span>
                    <span class="sr-only"> (ComparadorTarifaLuz.es)</span>
                  </a>
                ) : (
                  <a href={x.href} aria-current={x.activo ? "page" : undefined}>{x.t}</a>
                )
              ))}
            </div>
          </nav>
        )
      }
    </header>

    <main id="contenido">
      <slot />
      {anuncioFinal && <Anuncio tipo="multiplex" seccion />}
    </main>

    <footer class="pie">
      <div class="wrap">
        <div class="pie__grid">
          <div class="pie__marca">
            <Logo blanco />
            <p>{L.nota}</p>
          </div>
          <div>
            <p class="pie__titulo">{L.otrosPaises}</p>
            <ul>
              {PAISES_CON_DATOS.map((p) => <li><a href={`/${p.cc}/`}>{TEXTOS[p.lang].precio} {TEXTOS[p.lang].hoy} · {p.nombre}</a></li>)}
              <li><a href={SITIO.espana} hreflang="es" target="_blank" rel="noopener"><MarcaCtl tam={16} />Precio de la luz hoy · España <span aria-hidden="true">↗</span></a></li>
            </ul>
          </div>
          <div>
            <p class="pie__titulo">{L.carburantes}</p>
            <ul>
              {PAISES_C.map((p) => <li><a href={urlPrecios(p)} hreflang={p.locale}>{textosC(p).tituloPais(en(p, CC(p)))}</a></li>)}
            </ul>
          </div>
          <div>
            <p class="pie__titulo">{SITIO.nombre}</p>
            <ul>
              {[...new Set(GUIAS.map((g) => g.cc))].map((cc) => {
                const p = PAISES.find((x) => x.cc === cc)!;
                return <li><a href={urlGuias(cc)} hreflang={p.locale}>{TITULO_GUIAS[p.lang]} · {p.nombre}</a></li>;
              })}
              <li><a href={enEspanol ? "/es/quienes-somos/" : "/about/"}>{ACERCA[lang][0]}</a></li>
              <li><a href={enEspanol ? "/es/contacto/" : "/contact/"}>{ACERCA[lang][1]}</a></li>
              <li><a href="/legal/">{L.legal}</a></li>
            </ul>
          </div>
        </div>
        <p class="pie__legal">
          {`${L.aviso} ${L.fuente}${lang === "fr" ? " : " : ": "}ENTSO-E · Bundesnetzagentur | SMARD.de (CC BY 4.0) · ${lang === "en" ? "European Commission" : "EU"} · ${lang === "de" ? "EZB" : lang === "fr" ? "BCE" : lang === "it" ? "BCE" : lang === "pt" ? "BCE" : "ECB"}. © ${new Date().getFullYear()} ${SITIO.nombre}`}
          {codigoAdsense() && <> · <a href="/legal/" data-preferencias-privacidad>Privacy settings</a></>}
        </p>
      </div>
    </footer>

    <script is:inline>
      // Cierra el selector de país al pulsar fuera.
      document.addEventListener("click", function (e) {
        document.querySelectorAll("details.g-selector[open]").forEach(function (d) {
          if (!d.contains(e.target)) d.removeAttribute("open");
        });
      });
    </script>
    {
      codigoAdsense() && (
        <script is:inline>
          document.addEventListener("click", function (e) {
            var a = e.target.closest && e.target.closest("[data-preferencias-privacidad]");
            if (!a) return;
            e.preventDefault();
            window.googlefc = window.googlefc || {};
            window.googlefc.callbackQueue = window.googlefc.callbackQueue || [];
            window.googlefc.callbackQueue.push(function () { window.googlefc.showRevocationMessage(); });
          });
        </script>
      )
    }
    {
      codigoAdsense() && (
        <script is:inline>
          document.querySelectorAll("ins.adsbygoogle:not([data-adsbygoogle-status])").forEach(function () {
            (window.adsbygoogle = window.adsbygoogle || []).push({});
          });
        </script>
      )
    }
  </body>
</html>

<style>
  .g-nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 8px 24px;
  }
  .g-logo {
    display: inline-flex;
    text-decoration: none;
  }
  .g-logo:hover {
    opacity: 0.85;
  }
  .g-externo {
    display: inline-flex;
    align-items: center;
  }
  .g-externo__flecha {
    margin-left: 4px;
    font-size: 0.85em;
    opacity: 0.6;
  }
  /* Selector de país: desplegable sin JavaScript */
  .g-selector {
    position: relative;
  }
  .g-selector summary {
    list-style: none;
    cursor: pointer;
    font-size: 14px;
    font-weight: 600;
    padding: 6px 12px;
    border-radius: var(--radius-buttons);
    border: 1px solid var(--color-pale-sage);
    color: var(--color-bark);
    user-select: none;
  }
  .g-selector summary::-webkit-details-marker {
    display: none;
  }
  .g-selector > summary::before {
    content: none;
  }
  .g-selector > summary {
    gap: 6px;
  }
  .g-selector[open] summary {
    border-color: #ea580c;
  }
  .g-flecha {
    font-size: 11px;
  }
  .g-selector ul {
    position: absolute;
    right: 0;
    top: calc(100% + 6px);
    z-index: 60;
    margin: 0;
    padding: 6px;
    list-style: none;
    min-width: 220px;
    background: var(--color-sheet-white);
    border: 1px solid var(--color-pale-sage);
    border-radius: var(--radius-cards);
    box-shadow: 0 10px 30px rgba(16, 67, 54, 0.15);
    display: grid;
    gap: 2px;
  }
  .g-selector a {
    display: flex;
    gap: 10px;
    align-items: center;
    padding: 8px 10px;
    border-radius: 8px;
    text-decoration: none;
    color: var(--color-bark);
    font-size: 15px;
  }
  .g-selector a:hover,
  .g-selector a[aria-current="page"] {
    background: var(--color-sage-mist);
  }
  .g-cc {
    font-size: 12px;
    font-weight: 700;
    color: var(--color-slate);
    width: 22px;
  }
  /* Menú de la sección del país */
  .g-menu {
    border-top: 1px solid var(--color-pale-sage);
    background: var(--color-sheet-white);
  }
  .g-menu__in {
    display: flex;
    gap: 4px;
    overflow-x: auto;
    scrollbar-width: none;
  }
  .g-menu__in::-webkit-scrollbar {
    display: none;
  }
  .g-menu a {
    flex: none;
    white-space: nowrap;
    padding: 10px 12px;
    font-size: 15px;
    color: var(--color-bark);
    text-decoration: none;
    border-bottom: 3px solid transparent;
  }
  .g-menu a:hover {
    color: var(--color-ink);
    border-bottom-color: var(--color-pale-sage);
  }
  .g-menu a[aria-current="page"] {
    color: var(--color-ink);
    font-weight: 600;
    border-bottom-color: #ea580c;
  }
</style>
