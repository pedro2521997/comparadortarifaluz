---
import "../styles/global.css";
import "../styles/componentes.css";
import Logo from "../components/Logo.astro";
import { SITIO, NAV, TELEGRAM_URL, CARBURANTES } from "../config";
import { dias } from "../lib/datos";
import { frase } from "../lib/grafico";
import { fechaCorta, hoyMadrid } from "../lib/formato";
import Anuncio from "../components/Anuncio.astro";
import { GRUPOS_HERRAMIENTAS, HERRAMIENTAS } from "../lib/herramientas";
import { codigoAdsense, clienteAdsense, cuentaAdsense } from "../lib/anuncios-html.mjs";

interface Props {
  titulo: string;
  descripcion?: string;
  /** JSON-LD opcional */
  schema?: Record<string, unknown> | Record<string, unknown>[];
  noindex?: boolean;
  /** Anuncio antes del pie (no en legales ni en el 404) */
  anuncioFinal?: boolean;
  /** Ruta de migas de pan para los datos estructurados: [["Guías", "/guias/"], ["Título"]] */
  migas?: [string, string?][];
}
const { titulo, descripcion = SITIO.descripcion, schema, noindex = false, anuncioFinal = true, migas } = Astro.props;
const adsense = codigoAdsense();
// Datos estructurados comunes: la web y, si hay, las migas de pan (ayudan a Google y a los buscadores con IA).
const esquemas = [
  ...(schema ? (Array.isArray(schema) ? schema : [schema]) : []),
  ...(Astro.url.pathname === "/"
    ? [
        {
          "@context": "https://schema.org",
          "@type": "WebSite",
          name: SITIO.nombre,
          alternateName: SITIO.dominio,
          url: SITIO.url,
          inLanguage: "es-ES",
          description: SITIO.descripcion,
          publisher: { "@type": "Organization", name: SITIO.nombre, url: SITIO.url, logo: new URL("/favicon.svg", SITIO.url).href },
        },
      ]
    : []),
  ...(migas
    ? [{
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        itemListElement: [["Inicio", "/"], ...migas].map(([n, u], i) => ({ "@type": "ListItem", position: i + 1, name: n, ...(u ? { item: new URL(u, SITIO.url).href } : {}) })),
      }]
    : []),
];
const canonical = new URL(Astro.url.pathname, SITIO.url).href;
// Los títulos largos ya dicen lo que importa: la marca solo se añade si cabe (unos 60 caracteres en Google).
const tituloCompleto = titulo.includes(SITIO.nombre) || titulo.length > 42 ? titulo : `${titulo} | ${SITIO.nombre}`;
const ruta = Astro.url.pathname;

// Barra de aviso: el último día publicado, siempre con su fecha para no presentar un dato viejo como nuevo.
const ultimo = dias[dias.length - 1];
const aviso = ultimo
  ? {
      texto: `${fechaCorta(ultimo.fecha)}: ${frase(ultimo.precios)}`,
      fecha: ultimo.fecha,
      href: ultimo.fecha > hoyMadrid() ? "/precio-luz-manana/" : `/precio-luz/${ultimo.fecha}/`,
    }
  : null;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{tituloCompleto}</title>
    <meta name="description" content={descripcion} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#104336" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:site_name" content={SITIO.nombre} />
    <meta property="og:title" content={tituloCompleto} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:url" content={canonical} />
    {esquemas.length > 0 && <script type="application/ld+json" set:html={JSON.stringify(esquemas.length === 1 ? esquemas[0] : esquemas)} />}
    {/* Verificación de AdSense: la etiqueta meta y, con «codigo» o anuncios activos, el script en el <head>. */}
    {cuentaAdsense() && <meta name="google-adsense-account" content={cuentaAdsense()} />}
    {
      adsense && (
        <>
          <script async src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${clienteAdsense()}`} crossorigin="anonymous" />
        </>
      )
    }
  </head>
  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    {
      aviso && (
        <aside class="aviso-barra" aria-label="Precio de la luz">
          <a class="wrap aviso-barra__in" href={aviso.href} data-aviso-fecha={aviso.fecha}>
            <span>{aviso.texto}</span>
            <span aria-hidden="true">→</span>
          </a>
        </aside>
      )
    }
    <header class="nav">
      <div class="wrap nav__in">
        <a href="/" class="nav__logo" aria-label={`${SITIO.nombre}, inicio`}>
          <Logo />
        </a>
        <nav aria-label="Principal" class="nav__links" id="menu">
          <ul>
            {
              NAV.map((n) =>
                n.href === "/herramientas/" ? (
                  <li class="nav__menu">
                    <button type="button" class="nav__desplegar" aria-expanded="false" aria-controls="menu-herramientas" aria-current={HERRAMIENTAS.some((h) => ruta.startsWith(h.href)) || ruta.startsWith("/herramientas/") ? "page" : undefined}>
                      {n.texto} <span aria-hidden="true" class="nav__flecha">▾</span>
                    </button>
                    <div class="nav__panel" id="menu-herramientas" hidden>
                      <div class="nav__panel-in">
                        {GRUPOS_HERRAMIENTAS.map((g) => (
                          <div>
                            <p class="nav__grupo">{g.titulo}</p>
                            <ul>
                              {g.items.map((h) => (
                                <li>
                                  <a href={h.href} aria-current={ruta === h.href ? "page" : undefined}>
                                    {h.t}
                                    {h.nueva && <span class="nav__nueva">Nueva</span>}
                                  </a>
                                </li>
                              ))}
                            </ul>
                          </div>
                        ))}
                      </div>
                      <a class="nav__todas" href="/herramientas/">Ver todas las herramientas →</a>
                    </div>
                  </li>
                ) : (
                  <li>
                    <a href={n.href} aria-current={ruta.startsWith(n.href) ? "page" : undefined}>
                      {n.texto}
                    </a>
                  </li>
                ),
              )
            }
          </ul>
          <a class="btn btn--small nav__cta" href="/comparador/">Compara tu tarifa</a>
        </nav>
        <button class="nav__toggle" type="button" aria-expanded="false" aria-controls="menu">
          <span class="sr-only">Menú</span>
          <span class="nav__burger" aria-hidden="true"></span>
        </button>
      </div>
    </header>

    <main id="contenido">
      <slot />
      {anuncioFinal && <Anuncio tipo="multiplex" seccion />}
    </main>

    <footer class="pie">
      <div class="wrap">
        <div class="pie__grid pie__grid--5">
          <div class="pie__marca">
            <Logo blanco />
            <p>Pagar menos luz con tus datos y el precio real de hoy. Sin letra pequeña.</p>
            <p class="pie__neutral">
              El comparador ordena solo por precio. Si una tarifa nos paga comisión, lo decimos y no sube en la lista.
              <a href="/como-funciona/">Cómo funciona</a>
            </p>
          </div>
          <div>
            <p class="pie__titulo">Herramientas</p>
            <ul>
              {HERRAMIENTAS.map((h) => <li><a href={h.href}>{h.t}</a></li>)}
              <li><a href="/precio-luz-ayer/">Precio de la luz ayer</a></li>
              <li><a href="/precio-luz/">Archivo de precios</a></li>
            </ul>
          </div>
          <div>
            <p class="pie__titulo">Aprende</p>
            <ul>
              <li><a href="/guias/">Todas las guías</a></li>
              <li><a href="/guias/periodos-2-0td/">Punta, llano y valle</a></li>
              <li><a href="/guias/descargar-consumo-datadis/">Descargar tu consumo</a></li>
              <li><a href="/guias/potencia-contratada/">Potencia contratada</a></li>
              <li><a href="/guias/por-que-sube-la-luz/">Por qué sube la luz</a></li>
              {TELEGRAM_URL && <li><a href={TELEGRAM_URL}>Canal de Telegram</a></li>}
            </ul>
          </div>
          <div>
            <p class="pie__titulo">Gasolina y gasoil</p>
            <ul>
              <li><a href={CARBURANTES.gasolina}>Precio de la gasolina hoy</a></li>
              <li><a href={CARBURANTES.gasoil}>Precio del gasoil hoy</a></li>
              <li><a href={CARBURANTES.mapa}>Mapa de gasolineras</a></li>
              <li><a href={CARBURANTES.baratas}>Gasolineras baratas por provincia</a></li>
            </ul>
          </div>
          <div>
            <p class="pie__titulo">Transparencia</p>
            <ul>
              <li><a href="/como-funciona/">Cómo funciona y cómo ganamos dinero</a></li>
              <li><a href="/contacto/">Contacto</a></li>
              <li><a href="/aviso-legal/">Aviso legal</a></li>
              <li><a href="/condiciones-de-uso/">Condiciones de uso</a></li>
              <li><a href="/privacidad/">Privacidad</a></li>
              <li><a href="/cookies/">Cookies</a></li>
            </ul>
          </div>
        </div>
        <p class="pie__legal">
          Los cálculos son estimaciones, no ofertas vinculantes. Precios de la luz: Red Eléctrica (REData).
          © {new Date().getFullYear()} {SITIO.nombre}
          {codigoAdsense() && <> · <a href="/cookies/" data-preferencias-privacidad>Preferencias de privacidad</a></>}
        </p>
      </div>
    </footer>

    {
      codigoAdsense() && (
        <script is:inline>
          document.addEventListener("click", function (e) {
            var a = e.target.closest && e.target.closest("[data-preferencias-privacidad]");
            if (!a) return;
            e.preventDefault();
            window.googlefc = window.googlefc || {};
            window.googlefc.callbackQueue = window.googlefc.callbackQueue || [];
            window.googlefc.callbackQueue.push(function () { window.googlefc.showRevocationMessage(); });
          });
        </script>
      )
    }

    {
      adsense && (
        <script is:inline>
          (function () {
            function activar() {
              document.querySelectorAll("ins.adsbygoogle:not([data-adsbygoogle-status])").forEach(function () {
                (window.adsbygoogle = window.adsbygoogle || []).push({});
              });
            }
            if (document.readyState === "loading") document.addEventListener("DOMContentLoaded", activar);
            else activar();
            document.addEventListener("anuncios", activar);
          })();
        </script>
      )
    }
    <script>
      // Enlaces a otras webs: en una pestaña nueva, para no perder la página (ni el cálculo hecho en ella).
      // Se marcan al cargar y, para los que se pintan después (ranking, calculadoras), justo al pulsarlos.
      const esExterno = (a: HTMLAnchorElement) => {
        if (!/^https?:$/.test(a.protocol) || a.hasAttribute("download")) return false;
        const host = a.hostname.replace(/^www\./, "");
        return host !== location.hostname.replace(/^www\./, "") && !host.endsWith(".comparadortarifaluz.es") && host !== "comparadortarifaluz.es";
      };
      const marcar = (a: HTMLAnchorElement) => {
        if (a.dataset.externo || !esExterno(a)) return;
        a.dataset.externo = "1";
        if (!a.target) a.target = "_blank";
        const rel = new Set((a.rel || "").split(/\s+/).filter(Boolean));
        rel.add("noopener");
        a.rel = [...rel].join(" ");
        // Para lectores de pantalla: avisar de que se abre en otra pestaña.
        const aviso = document.createElement("span");
        aviso.className = "sr-only";
        aviso.textContent = " (se abre en una pestaña nueva)";
        a.append(aviso);
      };
      document.querySelectorAll<HTMLAnchorElement>("a[href]").forEach(marcar);
      document.addEventListener(
        "click",
        (e) => {
          const a = (e.target as Element | null)?.closest?.<HTMLAnchorElement>("a[href]");
          if (a) marcar(a);
        },
        true,
      );

      const boton = document.querySelector<HTMLButtonElement>(".nav__toggle");
      const menu = document.getElementById("menu");
      boton?.addEventListener("click", () => {
        const abierto = boton.getAttribute("aria-expanded") === "true";
        boton.setAttribute("aria-expanded", String(!abierto));
        menu?.classList.toggle("is-open", !abierto);
      });
      // Desplegable de herramientas: se abre con clic (y teclado), se cierra al salir o con Escape.
      const desplegar = document.querySelector<HTMLButtonElement>(".nav__desplegar");
      const panel = document.getElementById("menu-herramientas");
      const cerrarPanel = () => {
        desplegar?.setAttribute("aria-expanded", "false");
        if (panel) panel.hidden = true;
      };
      desplegar?.addEventListener("click", () => {
        const abierto = desplegar.getAttribute("aria-expanded") === "true";
        desplegar.setAttribute("aria-expanded", String(!abierto));
        if (panel) panel.hidden = abierto;
      });
      document.addEventListener("click", (e) => {
        if (panel && !panel.hidden && !(e.target as Element).closest(".nav__menu")) cerrarPanel();
      });
      document.addEventListener("keydown", (e) => {
        if (e.key !== "Escape") return;
        if (panel && !panel.hidden) {
          cerrarPanel();
          desplegar?.focus();
        } else if (boton?.getAttribute("aria-expanded") === "true") {
          boton.setAttribute("aria-expanded", "false");
          menu?.classList.remove("is-open");
          boton.focus();
        }
      });
    </script>
  </body>
</html>
