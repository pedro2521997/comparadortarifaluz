---
// Portada global (inglés): el precio de hoy en cada país, con enlace a su página en su idioma.
import Base from "../layouts/Base.astro";
import Anuncio from "../components/Anuncio.astro";
import MarcaCtl from "../components/MarcaCtl.astro";
import { SITIO } from "../config";
import { MERCADOS, info, hoyDe, alternativas } from "../lib/datos";
import { TEXTOS } from "../lib/textos";
import { valor } from "../lib/bloque";
import { PAISES_C, textosC, urlPrecios, litro, CC } from "../lib/carburantes";
import { ultimo } from "../../../web/src/lib/compartido/carburantes-ue";

const filas = MERCADOS.filter((m) => m.principal).map((m) => ({ m, i: info(m, hoyDe(m)) }));
---

<Base
  titulo="Electricity and fuel prices today in Europe"
  descripcion="Hourly electricity prices for today and tomorrow, plus petrol, diesel and heating oil prices, in each European country's language and currency."
  lang="en"
  alternativas={alternativas("hoy")}
>
  <section class="hero hero--compacto">
    <div class="wrap">
      <span class="eyebrow">{SITIO.nombre}</span>
      <h1>Electricity prices today, country by country</h1>
      <p class="lead">Hourly day-ahead spot prices in each country's own language and currency, with the cheapest hours to run the washing machine or charge the car. Updated every day.</p>
    </div>
  </section>
  <section class="section section--tight">
    <div class="wrap grid grid--3">
      {
        filas.map(({ m, i }) => (
          <a class="card card--link" href={m.ruta} hreflang={m.pais.locale}>
            <strong>{m.pais.nombre} <span class="muted small">· {m.pais.nombreEn}</span></strong>
            <span>{TEXTOS[m.pais.lang].precio} {TEXTOS[m.pais.lang].hoy}</span>
            {i && <span class="caption">{`${TEXTOS[m.pais.lang].media}${m.pais.lang === "fr" ? " : " : ": "}${valor(i.f, i.r.media)} · ${TEXTOS[m.pais.lang].horaBarata}${m.pais.lang === "fr" ? " : " : ": "}${TEXTOS[m.pais.lang].reloj(i.r.min.h)}`}</span>}
          </a>
        ))
      }
      <a class="card card--link" href={SITIO.espana} hreflang="es-ES" target="_blank" rel="noopener">
        <strong><MarcaCtl />España <span class="muted small">· Spain</span> <span aria-hidden="true">↗</span></strong>
        <span>Precio de la luz hoy (PVPC)</span>
        <span class="caption">comparadortarifaluz.es</span>
      </a>
    </div>
  </section>
  <section class="section section--white section--tight">
    <div class="wrap">
      <h2 style="font-size:28px;margin-bottom:16px">Fuel prices: petrol, diesel and heating oil</h2>
      <div class="grid grid--3">
        {
          PAISES_C.map((p) => (
            <a class="card card--link" href={urlPrecios(p)} hreflang={p.locale}>
              <strong>{p.nombre} <span class="muted small">· {p.nombreEn}</span></strong>
              <span>{`${textosC(p).productos.euro95}${p.lang === "fr" ? " : " : ": "}${litro(p, ultimo(CC(p), "euro95")!.valor)}`}</span>
              <span class="caption">{`${textosC(p).productos.diesel}${p.lang === "fr" ? " : " : ": "}${litro(p, ultimo(CC(p), "diesel")!.valor)}`}</span>
            </a>
          ))
        }
      </div>
    </div>
  </section>
  <Anuncio tipo="horizontal" seccion />
  <section class="section section--white">
    <div class="wrap wrap--narrow prose">
      <h2>What these prices are</h2>
      <p>They are the wholesale prices of the European day-ahead market for each bidding zone, published around 13:00 CET for the next day. Households on dynamic or hourly tariffs pay them directly, plus VAT, grid fees, taxes and the supplier's margin. On fixed-price contracts they show when the grid is under more pressure.</p>
      <p>Since October 2025 the market clears every 15 minutes; we show the average of each clock hour in local time. Sources: ENTSO-E Transparency Platform and Bundesnetzagentur | SMARD.de (CC BY 4.0). Currency conversion with the daily reference rates of the European Central Bank.</p>
    </div>
  </section>
</Base>
