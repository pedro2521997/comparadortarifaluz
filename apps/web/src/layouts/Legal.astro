---
import Base from "./Base.astro";
interface Props {
  titulo: string;
  revisado: string;
}
const { titulo, revisado } = Astro.props;
---

<Base titulo={titulo} noindex={false}>
  <section class="hero hero--compacto">
    <div class="wrap wrap--narrow">
      <span class="eyebrow">Legal</span>
      <h1>{titulo}</h1>
      <p class="caption" style="margin-top:16px">Última actualización: {revisado}</p>
    </div>
  </section>
  <section class="section section--white section--tight">
    <div class="wrap wrap--narrow">
      <div class="notice notice--warn" style="margin-bottom:32px">
        <p><strong>Borrador pendiente de revisión legal.</strong> Este texto debe revisarlo un profesional antes de publicar la web y completar los datos marcados entre corchetes.</p>
      </div>
      <div class="prose"><slot /></div>
    </div>
  </section>
</Base>
