---
// Mapa de gasolineras de un país (FR, ES, IT, PT) en el idioma de una sección de la web global: mapa con
// buscador, «cerca de mí» y lista de las más baratas de la zona (en el navegador), y debajo las cifras del día
// en HTML para quien no tiene JavaScript y para los buscadores.
import Base from "../layouts/Base.astro";
import Anuncio from "./Anuncio.astro";
import { nombrePais } from "../../../web/src/lib/compartido/carburantes-ue";
import { CC, en, urlPrecios, urlDestino, PAISES_C, textosC } from "../lib/carburantes";
import { estaciones, resumen, masBaratas, autopista, soloContinente, urlMapa, urlDatos, alternativasMapa, MAPAS, GASOLINA, LIMITES, FUENTE_MAPA, type Comb } from "../lib/mapa";
import { TEXTOS_M } from "../lib/textos-mapa";
import { TEXTOS } from "../lib/textos";
import { esquemaFaq, recortarFrases, type Pais } from "../lib/datos";
import { PROVINCIAS, urlProvincia } from "../lib/gasolineras";
import { zonasDe, urlRegion, urlZonas } from "../lib/zonas";

interface Props { p: Pais; cc: string }
const { p, cc } = Astro.props;
const T = TEXTOS_M[p.lang]!;
const A = T.app;
const L = TEXTOS[p.lang];
const d = estaciones(cc)!;
const enX = en(p, cc);
const sep = p.lang === "fr" ? " : " : ": ";
const nf = (dec: number) => new Intl.NumberFormat(p.locale, { minimumFractionDigits: dec, maximumFractionDigits: dec });
const litro = (x: number) => `${nf(3).format(x)} €/l`;
const pct = (x: number) => new Intl.NumberFormat(p.locale, { style: "percent", maximumFractionDigits: 0 }).format(x);
const hora = new Intl.DateTimeFormat(p.locale, { day: "numeric", month: "long", hour: "2-digit", minute: "2-digit", timeZone: p.tz }).format(new Date(d.actualizado));

const G = GASOLINA[cc];
const D: Comb = "diesel";
const rG = resumen(cc, G)!;
const rD = resumen(cc, D)!;
const lead = T.lead({ n: nf(0).format(d.e.length), enX, G: T.comb[G], g: litro(rG.media), d: litro(rD.media), dArt: T.combArt[D], gArt: T.combArt[G] });

/** «Total, Rue X» o solo la dirección (las gasolineras francesas no traen nombre). */
const sitio = (f: (typeof d.e)[number]) => [f[2], f[3]].filter(Boolean).join(", ") || T.estacion;
const tablas = [D, G].map((k) => ({ k, filas: masBaratas(cc, k) }));
const bD = tablas[0].filas[0];
const au = autopista(cc, D);
const auFrase = au && au.a > au.r ? T.autopistaFrase(T.combArt[D], pct(au.a / au.r - 1), litro(au.a), litro(au.r)) : null;
const preguntas = [
  { p: T.pBarata(T.combArt[D], enX), r: T.rBarata({ cArt: T.combArt[D], enX, sitio: sitio(bD.f), lugar: bD.f[4], precio: litro(bD.precio), media: litro(rD.media) }) },
  { p: T.pActual, r: T.rActual(T.fuentes[cc as keyof typeof T.fuentes], hora) },
  ...(auFrase ? [{ p: T.pAutopista, r: auFrase }] : []),
];

// Carburantes con datos de verdad (al menos 50 gasolineras), en el orden del fichero.
const combs = d.combustibles.filter((k) => (resumen(cc, k)?.n ?? 0) >= 50);
const config = {
  datos: urlDatos(cc),
  cc,
  locale: p.locale,
  limites: LIMITES[cc],
  inicial: G,
  combustibles: Object.fromEntries(combs.map((k) => [k, T.comb[k]])),
  t: {
    vacio: T.vacio, ruta: T.ruta, precioDel: T.precioDel("{f}"), autopista: T.autopista, sinDatos: T.sinDatos, sinUbicacion: T.sinUbicacion,
    estacion: T.estacion, lugares: T.lugares, estaciones: [T.estaciones(1, "1"), T.estaciones(2, "{n}")], nada: T.nada, gestos: T.gestos, baratasZona: T.baratasZona,
    // Las frases con datos van como plantilla ({l}, {n}…): el script las rellena.
    app: {
      ...A,
      cercaDe: A.cercaDe("{l}"),
      laMasBarata: A.laMasBarata("{n}", "{p}", "{d}"),
      rutaResumen: A.rutaResumen("{km}", "{n}", "{d}"),
      km: A.km("{k}"),
      a: A.a("{d}"),
    },
  },
  fichas: cc === "ES" && p.lang === "es" ? "/es/gasolinera/" : null,
};
const configJson = JSON.stringify(config).replace(/</g, "\\u003c");
const otros = MAPAS.filter((x) => x !== cc);
const propio = cc === CC(p);
const enlaceFuel = propio ? urlPrecios(p) : PAISES_C.includes(p) ? urlDestino(p, cc) : null;
// En el mapa del propio país y en su idioma, enlaces a las provincias, departamentos o distritos: los buscadores
// llegan así a cada ciudad y gasolinera.
const z = propio ? zonasDe(p) : null;
const provincias: { nombre: string; href: string }[] =
  cc === "ES" && p.lang === "es" ? PROVINCIAS.map((x) => ({ nombre: x.nombre, href: urlProvincia(x) })) : z ? z.regiones.map((r) => ({ nombre: z.T.regionNombre(r.nombre, r.codigo), href: urlRegion(z, r) })) : [];
const tituloProvincias = z ? z.T.regionesT : "Gasolineras baratas por provincia";
---

<Base titulo={T.tituloSeo(enX).length <= 70 ? T.tituloSeo(enX) : T.titulo(enX)} descripcion={recortarFrases(lead, 158)} lang={p.lang} locale={p.locale} schema={esquemaFaq(preguntas)} alternativas={alternativasMapa(cc)}>
  {/* Las gasolineras se empiezan a descargar con el HTML, a la vez que el código del mapa. */}
  <link slot="head" rel="preload" href={urlDatos(cc)} as="fetch" crossorigin="anonymous" />
  <section class="hero hero--compacto">
    <div class="wrap">
      <span class="eyebrow">{nombrePais(cc, p.locale)} · {hora}</span>
      <h1>{T.titulo(enX)}</h1>
      <p class="lead">{lead}</p>
    </div>
  </section>

  <section class="section section--tight">
    <div class="wrap mapa" data-mapa>
      <div class="mapa__barra">
        <div class="mapa__buscar" role="search">
          <label class="visually-hidden" for="mapa-buscar">{T.buscar}</label>
          <input id="mapa-buscar" type="search" placeholder={T.placeholder} autocomplete="off" role="combobox" aria-expanded="false" aria-controls="mapa-resultados" data-buscar />
          <ul id="mapa-resultados" class="mapa__resultados" role="listbox" hidden></ul>
        </div>
        <button type="button" class="btn btn--small mapa__cerca" data-cerca><span aria-hidden="true">⌖</span> {T.cerca}</button>
        <button type="button" class="mapa__salir" data-salir aria-label={A.cerrar} title={A.cerrar}>✕</button>
      </div>
      <div class="mapa__combustibles" role="group" aria-label={T.combustible} data-combustibles>
        {combs.map((k) => <button type="button" class="mapa__chip" data-comb={k} aria-pressed={k === G ? "true" : "false"}>{T.comb[k]}</button>)}
      </div>
      <div class="mapa__cuerpo">
        <div class="mapa__lienzo" data-lienzo aria-label={T.titulo(enX)}>
          <p class="mapa__estado" data-estado>{T.cargando}</p>
          <div class="mapa__leyenda" data-leyenda hidden>
            <span data-min></span><span class="mapa__degradado" aria-hidden="true"></span><span data-max></span>
          </div>
          <button type="button" class="mapa__abrir" data-abrir-app><span aria-hidden="true">⤢</span> {A.pantalla}</button>
        </div>
        <aside class="mapa__panel">
          <div class="mapa__pestanas" role="tablist">
            <button type="button" role="tab" data-modo="baratas" aria-selected="true">{A.pestBaratas}</button>
            <button type="button" role="tab" data-modo="cerca" aria-selected="false">{A.pestCerca}</button>
            <button type="button" role="tab" data-modo="ruta" aria-selected="false">{A.pestRuta}</button>
            <button type="button" class="mapa__plegar" data-plegar aria-label={A.ocultar} title={A.ocultar}><span aria-hidden="true">▾</span></button>
          </div>
          <form class="mapa__ruta" data-ruta hidden>
            <label class="mapa__campo">
              <span>{A.desde}</span>
              <input id="mapa-origen" type="search" placeholder={A.miUbicacion} autocomplete="off" role="combobox" aria-expanded="false" aria-controls="mapa-origen-op" data-origen />
              <ul id="mapa-origen-op" class="mapa__resultados" role="listbox" hidden></ul>
            </label>
            <label class="mapa__campo" data-campo-parada hidden>
              <span>{A.por}</span>
              <input id="mapa-parada" type="search" placeholder={A.paradaPh} autocomplete="off" role="combobox" aria-expanded="false" aria-controls="mapa-parada-op" data-parada />
              <ul id="mapa-parada-op" class="mapa__resultados" role="listbox" hidden></ul>
            </label>
            <label class="mapa__campo">
              <span>{A.hasta}</span>
              <input id="mapa-destino" type="search" placeholder={A.destinoPh} autocomplete="off" role="combobox" aria-expanded="false" aria-controls="mapa-destino-op" data-destino required />
              <ul id="mapa-destino-op" class="mapa__resultados" role="listbox" hidden></ul>
            </label>
            <button type="button" class="mapa__anadir" data-anadir-parada>+ {A.anadirParada}</button>
            <label class="mapa__desvio">
              <span>{A.desvio}</span>
              <select data-desvio>
                <option value="1">1 km</option>
                <option value="2" selected>2 km</option>
                <option value="5">5 km</option>
              </select>
            </label>
            <div class="mapa__ruta-botones">
              <button type="submit" class="btn btn--small">{A.calcular}</button>
            </div>
            <div class="mapa__ruta-hecha">
              <button type="button" class="mapa__editar" data-editar><span aria-hidden="true">✎</span> <span data-trayecto></span></button>
              <button type="button" class="mapa__quitar" data-quitar aria-label={A.quitar} title={A.quitar}>✕</button>
            </div>
          </form>
          <div class="mapa__alternativas" data-alternativas role="group" aria-label={A.elegirRuta} hidden></div>
          <h2 data-titulo>{T.baratasZona}</h2>
          <div class="mapa__orden" data-orden hidden>
            <button type="button" data-orden-ruta="precio" aria-pressed="true">{A.porPrecio}</button>
            <button type="button" data-orden-ruta="paso" aria-pressed="false">{A.porPaso}</button>
          </div>
          <p class="mapa__resumen" data-resumen aria-live="polite"></p>
          <ol data-lista></ol>
        </aside>
      </div>
      <p class="caption">{L.fuente}{sep}<a href={FUENTE_MAPA[cc].url} rel="noopener">{FUENTE_MAPA[cc].nombre}</a>. {T.aviso} <span class="mapa__osm"><a href="https://routing.openstreetmap.de/" rel="noopener">OSRM (FOSSGIS)</a> · © OpenStreetMap · <a href="https://www.geonames.org/" rel="noopener">GeoNames</a> (CC BY 4.0).</span></p>
    </div>
    <script type="application/json" id="mapa-config" set:html={configJson} />
  </section>

  <Anuncio tipo="horizontal" seccion />

  <section class="section section--white section--tight">
    <div class="wrap stack" style="--stack:32px">
      <div class="grid grid--4 stats">
        <div class="stat"><span class="stat__label">{T.statN}</span><span class="stat__value" style="font-size:28px">{nf(0).format(d.e.length)}</span><span class="stat__sub"></span></div>
        <div class="stat"><span class="stat__label">{T.statMedia(T.comb[G])}</span><span class="stat__value" style="font-size:28px">{litro(rG.media)}</span><span class="stat__sub">{T.statMin(T.comb[G])}{sep}{litro(rG.min)}</span></div>
        <div class="stat"><span class="stat__label">{T.statMedia(T.comb[D])}</span><span class="stat__value" style="font-size:28px">{litro(rD.media)}</span><span class="stat__sub">{T.statMin(T.comb[D])}{sep}{litro(rD.min)}</span></div>
        {au && au.a > au.r && <div class="stat"><span class="stat__label">{T.comb[D]} · {T.autopista}</span><span class="stat__value" style="font-size:28px">{litro(au.a)}</span><span class="stat__sub">+{pct(au.a / au.r - 1)}</span></div>}
      </div>
      <div class="grid grid--2" style="gap:32px">
        {tablas.map(({ k, filas }) => (
          <div style="min-width:0">
            <h2 style="font-size:20px;margin-bottom:12px">{T.baratasT(T.comb[k], T.combArt[k], enX)}</h2>
            <div class="table-wrap" tabindex="0" role="region" aria-label={T.baratasT(T.comb[k], T.combArt[k], enX)}>
              <table class="tabla-precios">
                <thead><tr><th scope="col">{T.colEstacion}</th><th scope="col">{T.colLugar}</th><th scope="col" class="num">{T.colPrecio}</th></tr></thead>
                <tbody>
                  {filas.map(({ f, precio }) => (
                    <tr><td>{sitio(f)}</td><td>{f[4]}</td><td class="num">{litro(precio)}</td></tr>
                  ))}
                </tbody>
              </table>
            </div>
          </div>
        ))}
      </div>
      {soloContinente(cc) && <p class="caption">{T.notaContinente}</p>}
    </div>
  </section>

  <Anuncio tipo="horizontal" seccion />

  {
    provincias.length > 0 && (
      <section class="section section--tight">
        <div class="wrap">
          <h2 style="font-size:22px;margin-bottom:12px">{z ? <a href={urlZonas(z)}>{tituloProvincias}</a> : tituloProvincias}</h2>
          <ul class="mapa-provincias">
            {provincias.map((x) => <li><a href={x.href}>{x.nombre}</a></li>)}
          </ul>
        </div>
      </section>
    )
  }

  <section class="section section--white">
    <div class="wrap wrap--narrow">
      <h2 style="font-size:22px;margin-bottom:12px">{textosC(p).preguntasT}</h2>
      {preguntas.map((q) => (
        <details class="g-faq">
          <summary>{q.p}</summary>
          <p>{q.r}</p>
        </details>
      ))}
      {
        (otros.length > 0 || enlaceFuel) && (
          <>
            <h2 style="font-size:22px;margin:32px 0 12px">{T.otrosMapas}</h2>
            <div class="btn-row">
              {otros.map((x) => <a class="btn btn--ghost btn--small" href={urlMapa(p, x)}>{nombrePais(x, p.locale)}</a>)}
              {enlaceFuel && <a class="btn btn--ghost btn--small" href={enlaceFuel}>{L.carburantes}</a>}
            </div>
          </>
        )
      }
    </div>
  </section>
</Base>

<script>
  import "../scripts/mapa";
</script>

<style>
  .mapa {
    display: grid;
    gap: 12px;
    scroll-margin-top: 104px; /* que la cabecera fija no tape el buscador */
  }
  .mapa__barra {
    display: flex;
    gap: 8px;
    align-items: center;
  }
  .mapa__buscar {
    position: relative;
    flex: 1 1 auto;
    min-width: 0;
  }
  .mapa__buscar input,
  .mapa__campo[hidden],
  .mapa__anadir[hidden] {
    display: none;
  }
  .mapa__anadir {
    align-self: flex-start;
    justify-self: start;
    width: auto;
    text-align: left;
    padding: 4px 0;
    font: inherit;
    font-size: 14px;
    font-weight: 600;
    color: var(--color-canopy);
    background: none;
    border: 0;
    cursor: pointer;
  }
  .mapa__campo input {
    width: 100%;
    font-size: 16px; /* 16 px: así el iPhone no hace zoom al escribir */
  }
  .mapa__cerca {
    flex: none;
    white-space: nowrap;
  }
  .mapa__salir {
    display: none;
    flex: none;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: 1px solid var(--color-pale-sage);
    background: var(--color-sheet-white);
    font-size: 18px;
    cursor: pointer;
    color: var(--color-bark);
  }
  .mapa__resultados {
    position: absolute;
    z-index: 20;
    top: calc(100% + 4px);
    left: 0;
    right: 0;
    margin: 0;
    padding: 4px;
    list-style: none;
    background: var(--color-sheet-white);
    border: 1px solid var(--color-pale-sage);
    border-radius: var(--radius-cards);
    box-shadow: 0 8px 24px rgba(16, 67, 54, 0.15);
    max-height: 320px;
    overflow-y: auto;
  }
  .mapa__resultados :global(li) {
    padding: 10px;
    border-radius: 8px;
    cursor: pointer;
    display: flex;
    justify-content: space-between;
    gap: 12px;
    font-size: 15px;
    color: var(--color-bark);
  }
  .mapa__resultados :global(li[aria-selected="true"]),
  .mapa__resultados :global(li:hover) {
    background: var(--color-sage-mist);
  }
  .mapa__resultados :global(.cab) {
    font-size: 12px;
    color: var(--color-slate);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    cursor: default;
    background: none !important;
    padding: 6px 10px 2px;
  }
  .mapa__resultados :global(small) {
    color: var(--color-slate);
    white-space: nowrap;
  }
  .mapa__combustibles {
    display: flex;
    gap: 6px;
    overflow-x: auto;
    scrollbar-width: none;
  }
  .mapa__chip {
    flex: none;
    font: inherit;
    font-size: 14px;
    padding: 7px 14px;
    border-radius: var(--radius-pills);
    border: 1px solid var(--color-pale-sage);
    background: var(--color-sheet-white);
    color: var(--color-bark);
    cursor: pointer;
    white-space: nowrap;
  }
  .mapa__chip[aria-pressed="true"] {
    background: var(--color-canopy);
    border-color: var(--color-canopy);
    color: #fff;
  }
  .mapa__cuerpo {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 340px;
    gap: 16px;
  }
  .mapa__lienzo {
    position: relative;
    height: min(72vh, 640px);
    min-height: 380px;
    border-radius: var(--radius-cards);
    overflow: hidden;
    background: var(--color-sage-mist);
  }
  .mapa__estado {
    position: absolute;
    left: 12px;
    right: 12px;
    bottom: 44px;
    margin: 0 auto;
    max-width: 360px;
    padding: 10px 14px;
    text-align: center;
    color: var(--color-bark);
    background: rgba(255, 255, 255, 0.95);
    border-radius: 10px;
    box-shadow: 0 4px 16px rgba(16, 67, 54, 0.15);
    z-index: 3;
    pointer-events: none;
  }
  .mapa__estado[hidden] {
    display: none;
  }
  .mapa__leyenda {
    position: absolute;
    left: 10px;
    bottom: 10px;
    z-index: 2;
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 4px 8px;
    font-size: 12px;
    background: rgba(255, 255, 255, 0.92);
    border-radius: 6px;
  }
  .mapa__leyenda[hidden] {
    display: none;
  }
  .mapa__degradado {
    width: 72px;
    height: 8px;
    border-radius: 4px;
    background: linear-gradient(90deg, #1a9850, #f2c94c, #d73027);
  }
  .mapa__abrir {
    display: none;
    position: absolute;
    left: 10px;
    top: 10px;
    z-index: 2;
    font: inherit;
    font-size: 14px;
    font-weight: var(--font-weight-bold);
    padding: 9px 14px;
    border: 0;
    border-radius: var(--radius-pills);
    background: var(--color-canopy);
    color: #fff;
    box-shadow: 0 4px 14px rgba(16, 67, 54, 0.3);
    cursor: pointer;
  }

  /* Panel: pestañas, ruta y lista */
  .mapa__panel {
    display: flex;
    flex-direction: column;
    min-height: 0;
    max-height: min(72vh, 640px);
  }
  .mapa__pestanas {
    display: flex;
    gap: 2px;
    padding: 3px;
    border-radius: 12px;
    background: var(--color-sage-mist);
    margin-bottom: 10px;
  }
  .mapa__pestanas [role="tab"] {
    flex: 1 1 0;
    font: inherit;
    font-size: 13px;
    line-height: 1.2;
    padding: 8px 4px;
    border: 0;
    border-radius: 9px;
    background: none;
    color: var(--color-bark);
    cursor: pointer;
  }
  .mapa__pestanas [aria-selected="true"] {
    background: var(--color-sheet-white);
    font-weight: var(--font-weight-bold);
    color: var(--color-canopy);
    box-shadow: 0 1px 4px rgba(16, 67, 54, 0.15);
  }
  .mapa__plegar {
    display: none;
    flex: none;
    width: 34px;
    border: 0;
    background: none;
    font-size: 18px;
    cursor: pointer;
    color: var(--color-slate);
  }
  .mapa__ruta {
    display: grid;
    gap: 8px;
    margin-bottom: 10px;
  }
  .mapa__ruta[hidden] {
    display: none;
  }
  .mapa__campo {
    position: relative;
    display: grid;
    grid-template-columns: 52px minmax(0, 1fr);
    align-items: center;
    gap: 8px;
    font-size: 14px;
    color: var(--color-slate);
  }
  .mapa__campo .mapa__resultados {
    left: 60px;
  }
  .mapa__desvio {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    color: var(--color-slate);
  }
  .mapa__desvio select {
    font: inherit;
    font-size: 15px;
    padding: 4px 8px;
    border-radius: 8px;
    border: 1px solid var(--color-pale-sage);
    background: var(--color-sheet-white);
  }
  .mapa__ruta-botones {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
  }
  .mapa__ruta-botones .btn {
    flex: 1 1 auto;
  }
  /* Con la ruta ya calculada, el formulario se queda en una línea («✎ Madrid → Valencia  ✕») para dejar sitio a la lista. */
  .mapa__ruta-hecha {
    display: none;
    gap: 6px;
  }
  .mapa__ruta--hecha .mapa__ruta-hecha {
    display: flex;
  }
  .mapa__ruta--hecha .mapa__campo,
  .mapa__ruta--hecha .mapa__anadir,
  .mapa__ruta--hecha .mapa__desvio,
